/* pages/reveal/reveal.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --coral: #e67e5f;
  --terracotta: #9b442a;
  --cream: #f8f1e7;
  --paper: #fffdf8;
  background: var(--paper);
}

.reveal-page {
  min-height: 100vh;
  background-color: var(--paper);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.loading-state {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  height: 100vh;
  overflow: hidden;
  padding: 108rpx 36rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  color: var(--ink);
  text-align: center;
}

.loading-state::before {
  position: absolute;
  top: -122rpx;
  left: 50%;
  width: 420rpx;
  height: 420rpx;
  border: 2rpx solid rgba(239, 210, 209, 0.72);
  border-radius: 50%;
  content: '';
  transform: translateX(-50%);
}

.loading-brand,
.loading-status,
.loading-illustration,
.loading-title,
.loading-copy,
.loading-dots,
.loading-knowledge-card,
.loading-footer {
  position: relative;
}

.loading-brand {
  color: var(--terracotta);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.loading-status {
  margin-top: 10rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
}

.loading-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 368rpx;
  height: 368rpx;
  margin: 128rpx 0 48rpx;
  border: 2rpx dashed var(--line);
  border-radius: 50%;
  background: rgba(248, 241, 231, 0.52);
}

.loading-illustration::before {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  border: 2rpx solid rgba(215, 197, 179, 0.7);
  border-radius: 50%;
  content: '';
}

.loading-photo {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 218rpx;
  height: 250rpx;
  border: 2rpx solid var(--line);
  background: var(--cream);
  box-shadow: 0 16rpx 0 rgba(51, 40, 36, 0.08);
  transform: rotate(-5deg);
}

.loading-photo::before {
  position: absolute;
  top: 16rpx;
  left: 20rpx;
  width: 36rpx;
  height: 8rpx;
  background: var(--blush, #efd2d1);
  content: '';
}

.loading-cat {
  width: 166rpx;
  height: 200rpx;
  opacity: 0.82;
  filter: drop-shadow(0 12rpx 6rpx rgba(51, 40, 36, 0.14));
  animation: loadingCatBob 1.8s ease-in-out infinite;
}

.loading-heart {
  position: absolute;
  z-index: 2;
  top: 78rpx;
  right: 44rpx;
  color: var(--terracotta);
  font-size: 38rpx;
  transform: rotate(12deg);
}

.loading-star {
  position: absolute;
  z-index: 2;
  bottom: 80rpx;
  left: 48rpx;
  color: #c99a49;
  font-size: 34rpx;
  transform: rotate(-12deg);
}

.loading-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.15;
}

.loading-copy {
  margin-top: 14rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
}

.loading-dots {
  display: flex;
  flex-direction: row;
  margin-top: 36rpx;
}

.loading-dots view {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: var(--blush, #efd2d1);
  animation: loadingDot 1.2s ease-in-out infinite;
}

.loading-dots view:nth-child(2) { animation-delay: 0.16s; }
.loading-dots view:nth-child(3) { animation-delay: 0.32s; }

.loading-knowledge-card {
  width: 100%;
  margin-top: 34rpx;
  padding: 18rpx 22rpx 20rpx;
  border: 2rpx solid rgba(215, 197, 179, 0.9);
  background: rgba(248, 241, 231, 0.72);
  box-sizing: border-box;
  text-align: left;
}

.loading-knowledge-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  border-bottom: 2rpx dashed rgba(215, 197, 179, 0.72);
  padding-bottom: 12rpx;
}

.loading-knowledge-title {
  color: var(--terracotta);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.loading-knowledge-source {
  color: var(--terracotta);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
}

.loading-knowledge-text {
  display: block;
  margin-top: 14rpx;
  color: var(--ink);
  font-size: 20rpx;
  line-height: 1.55;
}

@keyframes loadingCatBob {
  0%, 100% { transform: translateY(2rpx) rotate(-1deg); }
  50% { transform: translateY(-8rpx) rotate(1deg); }
}

@keyframes loadingDot {
  0%, 80%, 100% { opacity: 0.35; transform: scale(0.8); }
  40% { opacity: 1; transform: scale(1.1); }
}

.loading-footer {
  margin-top: auto;
  color: var(--muted-ink);
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.reveal-scroll {
  height: 100vh;
}

.reveal-content {
  position: relative;
  padding: 34rpx 32rpx 0;
  box-sizing: border-box;
}

.reveal-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 22rpx;
  box-sizing: border-box;
}

.reveal-error-context {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-height: 100vh;
  padding-right: 40rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  padding-left: 40rpx;
  box-sizing: border-box;
  color: var(--ink);
  text-align: center;
}

.reveal-error-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 58rpx;
  box-sizing: border-box;
  text-align: left;
}

.reveal-error-stamp {
  display: inline-flex;
  align-items: center;
  margin-top: 46rpx;
  padding: 14rpx 18rpx;
  border: 2rpx solid var(--terracotta);
  color: var(--terracotta);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  transform: rotate(-2deg);
}

.reveal-error-scene {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 404rpx;
  margin: 40rpx 0 32rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 2rpx dashed var(--line);
  background: linear-gradient(145deg, #eee1d0, #d9e6d4);
}

.reveal-error-scene::before {
  position: absolute;
  right: -76rpx;
  bottom: -132rpx;
  width: 340rpx;
  height: 340rpx;
  border: 2rpx solid rgba(74, 101, 73, 0.18);
  border-radius: 50%;
  box-shadow: 0 0 0 48rpx rgba(74, 101, 73, 0.08), 0 0 0 96rpx rgba(74, 101, 73, 0.05);
  content: '';
}

.reveal-error-photo {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 236rpx;
  height: 302rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
  box-shadow: 0 16rpx 0 rgba(51, 40, 36, 0.1);
  transform: rotate(-5deg);
}

.reveal-error-photo::before {
  position: absolute;
  top: 20rpx;
  left: 22rpx;
  width: 56rpx;
  height: 10rpx;
  background: #efd2d1;
  content: '';
}

.reveal-error-photo image {
  width: 174rpx;
  height: 212rpx;
  opacity: 0.78;
  filter: drop-shadow(0 14rpx 6rpx rgba(51, 40, 36, 0.13));
}

.reveal-error-mark {
  position: absolute;
  z-index: 2;
  top: 50rpx;
  left: calc(50% + 76rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border: 2rpx solid var(--terracotta);
  border-radius: 50%;
  color: var(--terracotta);
  background: var(--paper);
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 700;
  transform: rotate(8deg);
}

.reveal-error-note {
  display: inline-block;
  margin-top: 22rpx;
  padding: 10rpx 16rpx;
  color: #4a6549;
  background: rgba(205, 225, 200, 0.55);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.reveal-error-title {
  display: block;
  margin-top: 4rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.reveal-error-title-em {
  color: var(--terracotta);
}

.reveal-error-lead {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  line-height: 1.55;
}

.reveal-error-actions {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 14rpx;
  width: 100%;
  margin-top: 34rpx;
}

.reveal-error-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.reveal-error-action-primary {
  color: var(--paper);
  background: var(--terracotta);
  box-shadow: 0 10rpx 0 rgba(75, 29, 18, 0.12);
}

.reveal-error-action-primary image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
}

.reveal-error-action-secondary {
  border: 2rpx solid var(--line);
  color: var(--terracotta);
  background: var(--paper);
}

.reveal-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.reveal-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--paper);
}

.reveal-brand-symbol image {
  width: 36rpx;
  height: 36rpx;
}

.reveal-brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.reveal-brand-name {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.1;
}

.reveal-brand-sub {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 15rpx;
  letter-spacing: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reveal-status {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border: 2rpx solid var(--line);
  color: var(--terracotta);
  background: var(--paper);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.reveal-close {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 34rpx;
  z-index: 2;
  width: 44rpx;
  height: 44rpx;
}

.reveal-close image {
  display: block;
  width: 100%;
  height: 100%;
}

.reveal-topline {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 24rpx;
}

.reveal-result-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 0 8rpx 18rpx;
}

.reveal-stamp {
  color: var(--terracotta);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.reveal-kicker {
  color: var(--coral);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.reveal-date {
  color: var(--muted-ink);
  font-size: 22rpx;
}

.new-note {
  display: inline-block;
  margin: 0 8rpx 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f9d9c9;
  color: #b45441;
  font-size: 22rpx;
  font-weight: 700;
}

.found-sheet {
  padding: 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  background: rgba(255, 253, 249, 0.9);
  box-shadow: 0 14rpx 30rpx rgba(74, 55, 40, 0.08);
}

.found-photo-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 610rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--paper);
}

.found-photo-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  background: var(--paper);
}

.found-photo-wrap-C .found-photo-backdrop,
.found-photo-wrap-U .found-photo-backdrop,
.found-photo-wrap-R .found-photo-backdrop,
.found-photo-wrap-SR .found-photo-backdrop,
.found-photo-wrap-UR .found-photo-backdrop { background-color: var(--paper); }

.found-photo {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
}

.found-photo-caption {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  left: 18rpx;
  z-index: 2;
}

.found-photo-code {
  display: inline-block;
  padding: 6rpx 10rpx;
  color: var(--paper);
  background: rgba(51, 40, 36, 0.66);
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.found-icon {
  position: relative;
  z-index: 1;
  width: 180rpx;
  height: 180rpx;
  opacity: 0.72;
}

.found-level-badge {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  z-index: 2;
  padding: 8rpx 14rpx 9rpx;
  border-radius: 10rpx;
  background: rgba(255, 253, 249, 0.9);
  color: var(--ink);
  font-weight: 700;
}

.found-level-code {
  font-size: 26rpx;
  font-weight: 800;
}

.found-level-label {
  margin-left: 8rpx;
  font-size: 21rpx;
}

.found-level-badge-C { color: #7f776c; }
.found-level-badge-U { color: #b47a3c; }
.found-level-badge-R { color: #46859b; }
.found-level-badge-SR { color: #8a6aa6; }
.found-level-badge-UR { color: #b85d43; }

.found-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}

.found-name {
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 800;
}

.breed-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  border: 2rpx solid #e7c8b8;
  border-radius: 10rpx;
  background: #fff8ef;
}

.breed-tag-key {
  margin-right: 10rpx;
  color: #ae7967;
  font-size: 20rpx;
}

.breed-tag-value {
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.trait-list {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin-top: 18rpx;
}

.trait-pill {
  margin: 0 6rpx;
  padding: 7rpx 16rpx;
  border: 2rpx solid #edc4b8;
  border-radius: 100rpx;
  color: #b35f4c;
  font-size: 22rpx;
}

.encounter-score-card {
  margin-top: 26rpx;
  padding: 22rpx 20rpx 18rpx;
  border: 2rpx solid #eadfd4;
  border-radius: 18rpx 14rpx 20rpx 16rpx;
  background: #fffaf3;
}

.encounter-score-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.encounter-score-title-wrap {
  display: flex;
  flex-direction: column;
}

.encounter-score-title {
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 800;
}

.encounter-score-subtitle {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 21rpx;
}

.encounter-score-total {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.encounter-score-total-value {
  color: var(--coral);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
}

.encounter-score-total-label {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
}

.score-list {
  margin-top: 18rpx;
}

.score-item {
  margin-top: 12rpx;
}

.score-item:first-child {
  margin-top: 0;
}

.score-item-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  color: var(--muted-ink);
  font-size: 21rpx;
}

.score-item-head text:last-child {
  color: var(--ink);
  font-weight: 700;
}

.score-track {
  height: 10rpx;
  margin-top: 7rpx;
  overflow: hidden;
  border-radius: 100rpx;
  background: #eee4d9;
}

.score-track-fill {
  height: 100%;
  min-width: 4rpx;
  border-radius: inherit;
  background: var(--coral);
}

.score-track-fill-C { background: #9d968b; }
.score-track-fill-U { background: #c48c4a; }
.score-track-fill-R { background: #6caabd; }
.score-track-fill-SR { background: #a789bd; }
.score-track-fill-UR { background: #ef745e; }

.reward-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #e6d8ca;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
}

.score-pending-note {
  display: block;
  margin-top: 10rpx;
  color: #aa9584;
  font-size: 18rpx;
  text-align: right;
}

.story-note {
  margin-top: 26rpx;
  padding: 22rpx 20rpx;
  border-left: 6rpx solid #eab8a9;
  background: #fff5ec;
}

.story-note-title {
  display: block;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 700;
}

.story-note-text {
  display: block;
  margin-top: 10rpx;
  color: var(--muted-ink);
  font-size: 24rpx;
  line-height: 1.7;
}

.reveal-actions {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
}

.action-secondary,
.action-primary {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.action-secondary {
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  background: #fffdf9;
  color: var(--muted-ink);
}

.action-primary {
  background: var(--coral);
  color: #fff;
}

.action-arrow {
  margin-left: 12rpx;
  width: 34rpx;
  height: 34rpx;
}

.reveal-bottom-safe {
  height: 100rpx;
}

/* V6 相遇结果：主体照片、档案信息与奖励使用同一层级。 */
.result-stamp {
  display: block;
  margin: 0 8rpx 20rpx;
  color: var(--terracotta);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  text-align: center;
}

.result-card {
  padding: 14rpx 14rpx 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: 0 14rpx 0 rgba(51, 40, 36, 0.08);
}

.result-photo {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 3 / 4;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fff;
}

.result-photo-wash {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: transparent;
}

.result-photo::after {
  display: none;
  content: '';
}

.result-photo-UR,
.result-photo-SR,
.result-photo-R,
.result-photo-U,
.result-photo-C {
  background: #fff;
}

.result-photo-image,
.result-photo-placeholder {
  position: relative;
  z-index: 1;
  display: block;
  width: 88%;
  height: 88%;
  filter: drop-shadow(0 30rpx 14rpx rgba(47, 38, 30, 0.25));
}

.result-photo-placeholder {
  width: 220rpx;
  height: 240rpx;
  opacity: 0.72;
}

.result-photo-caption {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  left: 20rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  color: var(--paper);
}

.result-photo-code {
  align-self: flex-start;
  padding: 6rpx 12rpx;
  color: var(--paper);
  background: rgba(51, 40, 36, 0.7);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.result-photo-name {
  margin-top: 8rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
  text-shadow: none;
}

.result-quote {
  display: block;
  margin: 22rpx 14rpx 0;
  color: var(--muted-ink);
  font-family: var(--font-display);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.result-meta-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}

.result-rarity {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  color: var(--terracotta);
  background: #f1cf84;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.result-rarity-icon {
  display: block;
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
}

.result-rarity-C { color: #46604a; background: #dce8d5; }
.result-rarity-U { color: #405c70; background: #d9e6ee; }
.result-rarity-R { color: #684718; background: #f1cf84; }
.result-rarity-SR { color: #873e30; background: #e8b2a7; }
.result-rarity-UR { color: #f0b760; background: #3b2d2a; }

.result-score {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 18rpx;
}

.result-score-value {
  margin-left: 8rpx;
  color: var(--terracotta);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.result-reward-row {
  display: flex;
  flex-direction: row;
  margin: 38rpx 30rpx 0;
}

.result-reward {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-sizing: border-box;
}

.result-reward:first-child {
  margin-right: 24rpx;
}

.result-reward-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.result-reward-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  margin-right: 0;
}

.result-reward-icon image {
  display: block;
  width: 34rpx;
  height: 34rpx;
}

.result-reward-icon-kaka {
  color: var(--gold, #c99a49);
  font-size: 38rpx;
}

.result-reward-label {
  overflow: hidden;
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-reward-value {
  display: block;
  margin: 6rpx 0 0 62rpx;
  color: var(--terracotta);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 30rpx;
  font-weight: 700;
}

.result-score-note {
  display: block;
  margin-top: 14rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-align: right;
}

.result-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  margin-top: 36rpx;
}

.result-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48rpx;
  padding: 8rpx 20rpx;
  color: var(--terracotta);
  box-sizing: border-box;
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.result-action-primary {
  min-height: 88rpx;
  padding: 0;
  border-radius: 999rpx;
  color: var(--paper);
  background: var(--coral);
  box-shadow: 0 12rpx 0 rgba(155, 68, 42, 0.17);
  letter-spacing: 0;
}

.result-action-primary image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
  filter: brightness(0) invert(1);
}

.result-action:active {
  opacity: 0.62;
  transform: translateY(1rpx);
}

.result-action-secondary {
  color: var(--muted-ink);
  font-size: 20rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
}

@media (max-width: 350px) {
  .result-photo-name {
    font-size: 32rpx;
  }

  .result-reward {
    padding-right: 0;
    padding-left: 0;
  }

  .result-reward-label {
    font-size: 12rpx;
  }

  .result-reward-value {
    margin-left: 50rpx;
    font-size: 21rpx;
  }
}
