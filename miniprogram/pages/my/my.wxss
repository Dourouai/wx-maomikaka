.dev-mode-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.24);
  background: var(--surface);
}

.dev-mode-entry:active,
.my-link:active {
  opacity: 0.78;
}

.dev-mode-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #efd2d1;
}

.dev-mode-entry-icon image {
  width: 46rpx;
  height: 46rpx;
}

.dev-mode-entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.dev-mode-entry-kicker {
  color: var(--stamp);
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.dev-mode-entry-title {
  margin-top: 5rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.dev-mode-entry-subtitle {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.dev-mode-entry-arrow,
.my-link-arrow {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}

.my-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 20rpx;
  background: var(--paper-deep);
}

.my-link-copy {
  display: flex;
  flex-direction: column;
}

.my-link-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.my-link-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
}

.my-bottom-safe {
  height: 26rpx;
}

/* 功能反馈与档案操作统一使用二次确认弹窗的视觉语言。 */
.feedback-modal-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10001;
}

.feedback-modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(51, 40, 36, 0.6);
}

.feedback-modal-card {
  position: absolute;
  top: 50%;
  right: 36rpx;
  left: 36rpx;
  padding: 38rpx 28rpx 32rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-shadow: 0 26rpx 56rpx rgba(51, 40, 36, 0.26);
  text-align: center;
  transform: translateY(-50%);
  box-sizing: border-box;
}

.feedback-modal-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.35);
  border-radius: 50%;
  background: #efd2d1;
}

.feedback-modal-symbol image {
  width: 38rpx;
  height: 38rpx;
}

.feedback-modal-eyebrow {
  display: block;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 2.56rpx;
}

.feedback-modal-title {
  display: block;
  margin: 18rpx 0 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.feedback-modal-message {
  display: block;
  margin: 14rpx 0 0;
  color: var(--muted-ink);
  font-family: var(--font-display);
  font-size: 20rpx;
  line-height: 1.5;
}

.feedback-modal-detail {
  display: block;
  padding-top: 16rpx;
  margin-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--muted-ink);
  font-size: 18rpx;
}

.feedback-modal-actions {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  margin-top: 28rpx;
}

.feedback-modal-action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--line);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.feedback-modal-close {
  color: var(--stamp);
  background: var(--paper);
}

.feedback-modal-copy {
  border-color: var(--stamp);
  color: var(--surface);
  background: var(--stamp);
}

.feedback-modal-action:active {
  opacity: 0.82;
}
