/* pages/text-image/text-image.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --coral: #e67e5f;
  --cream: #fffdf8;
  background-color: var(--cream);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.text-image-page {
  min-height: 100vh;
  background: transparent;
}

.text-image-scroll {
  height: calc(100vh - 88rpx - env(safe-area-inset-bottom));
}

.text-image-content {
  padding: 34rpx 32rpx 0;
  box-sizing: border-box;
}

.text-image-hero {
  position: relative;
  padding: 28rpx 26rpx 26rpx;
  overflow: hidden;
  border: 2rpx solid #eadfd4;
  border-radius: 28rpx 24rpx 30rpx 22rpx;
  background: #fffdf9;
  box-shadow: 4rpx 6rpx 0 rgba(74, 55, 40, 0.06);
}

.text-image-hero::after {
  position: absolute;
  right: -20rpx;
  bottom: -40rpx;
  width: 170rpx;
  height: 170rpx;
  border: 2rpx dashed rgba(239, 116, 94, 0.24);
  border-radius: 50%;
  content: '';
}

.text-image-hero-tape {
  position: absolute;
  top: 20rpx;
  right: 32rpx;
  width: 100rpx;
  height: 24rpx;
  background: rgba(194, 207, 172, 0.72);
  transform: rotate(7deg);
}

.text-image-kicker,
.prompt-card-kicker,
.result-card-kicker {
  display: block;
  color: var(--coral);
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.text-image-title {
  display: block;
  margin-top: 12rpx;
  color: var(--ink);
  font-size: 42rpx;
  font-family: var(--font-display);
  font-weight: 800;
}

.text-image-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 23rpx;
}

.text-image-note {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 9rpx 14rpx;
  border-radius: 10rpx 7rpx 9rpx 6rpx;
  background: #fff0e8;
  color: #ae7967;
  font-size: 19rpx;
}

.prompt-card,
.result-card {
  margin-top: 28rpx;
  padding: 28rpx 24rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 28rpx 24rpx 30rpx 22rpx;
  background: rgba(255, 253, 249, 0.92);
  box-shadow: 3rpx 6rpx 0 rgba(74, 55, 40, 0.05);
}

.prompt-card-head,
.result-card-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
}

.prompt-card-title,
.result-card-title {
  display: block;
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.prompt-card-count,
.result-card-status {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.prompt-input {
  width: 100%;
  min-height: 190rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #eadfd4;
  border-radius: 18rpx 14rpx 20rpx 16rpx;
  background: #fff;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.6;
}

.prompt-placeholder {
  color: #b9a99c;
}

.prompt-presets {
  margin-top: 20rpx;
}

.prompt-presets-label {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.prompt-preset-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.prompt-preset {
  margin: 0 10rpx 10rpx 0;
  padding: 9rpx 13rpx;
  border: 2rpx solid #eadfd4;
  border-radius: 100rpx;
  background: #fffaf4;
  color: #806c5e;
  font-size: 19rpx;
}

.prompt-preset:active {
  background: #fff0e8;
}

.generate-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 14rpx;
  border-radius: 100rpx;
  background: var(--coral);
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 18rpx rgba(239, 116, 94, 0.22);
}

.generate-button image {
  width: 40rpx;
  height: 40rpx;
  margin-right: 10rpx;
  filter: brightness(0) invert(1);
}

.generate-button-arrow {
  margin-left: 18rpx;
  font-size: 32rpx;
}

.generate-button-disabled {
  opacity: 0.62;
}

.result-card {
  padding-bottom: 26rpx;
}

.result-placeholder,
.result-image-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 460rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 20rpx 16rpx 22rpx 18rpx;
  background: #fff;
  background-image: radial-gradient(#eadfd4 1rpx, transparent 1rpx);
  background-size: 18rpx 18rpx;
}

.result-loading {
  background: #fffaf4;
}

.result-loading-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #fff0e8;
  animation: resultPulse 1.3s ease-in-out infinite;
}

.result-loading-mark image {
  width: 58rpx;
  height: 58rpx;
}

.result-placeholder-mark {
  color: #efb9a9;
  font-size: 68rpx;
}

.result-placeholder-title {
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
}

.result-placeholder-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 21rpx;
}

.result-image-wrap {
  min-height: 600rpx;
}

.result-image {
  display: block;
  width: 100%;
  height: 600rpx;
}

.result-image-tag {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 8rpx 12rpx;
  border-radius: 9rpx 7rpx 8rpx 6rpx;
  background: rgba(255, 253, 249, 0.9);
  color: #806c5e;
  font-size: 19rpx;
}

.result-meta {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
}

.text-image-bottom-safe {
  height: 180rpx;
}

@keyframes resultPulse {
  0%, 100% { transform: scale(0.94) rotate(-4deg); }
  50% { transform: scale(1.04) rotate(4deg); }
}
