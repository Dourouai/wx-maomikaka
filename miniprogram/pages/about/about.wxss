@import "../../styles/info-page.wxss";

.about-privacy-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 2rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(155, 68, 42, 0.14);
  border-bottom: 1rpx solid rgba(155, 68, 42, 0.14);
  background: transparent;
  box-sizing: border-box;
}

.about-privacy-entry:active {
  opacity: 0.72;
}

.about-privacy-entry-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: rgba(239, 210, 209, 0.48);
}

.about-privacy-entry-icon image {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.72;
}

.about-privacy-entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.about-privacy-entry-title {
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.about-privacy-entry-subtitle {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 16rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.about-privacy-entry-arrow {
  flex-shrink: 0;
  color: var(--muted-ink);
  font-size: 28rpx;
  line-height: 1;
  opacity: 0.62;
}
