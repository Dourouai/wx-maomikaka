}

.feedback-modal-detail {
  display: block;
  padding-top: 16rpx;
  margin-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--muted-ink);
  font-size: 18rpx;
}

.feedback-modal-actions {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  margin-top: 28rpx;
}

.feedback-modal-action {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--line);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.feedback-modal-close {
  color: var(--stamp);
  background: var(--paper);
}

.feedback-modal-copy {
  border-color: var(--stamp);
  color: var(--surface);
  background: var(--stamp);
}

.feedback-modal-action:active {
  opacity: 0.82;
}

