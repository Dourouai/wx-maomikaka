/* pages/camera/camera.wxss */
page {
  --ink: #332824;
  --muted-ink: #cbbcaf;
  --coral: #e67e5f;
  --paper: #fffdf8;
  --line: rgba(255, 253, 248, 0.58);
  background: #332b26;
}

.camera-page {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: #332b26;
}

.camera-topbar {
  position: absolute;
  top: 70rpx;
  right: 36rpx;
  left: 36rpx;
  z-index: 5;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  color: var(--paper);
}

.camera-count {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 56rpx;
  padding: 10rpx 18rpx 10rpx 12rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.18);
  border-radius: 100rpx;
  background: rgba(51, 40, 36, 0.42);
  box-shadow: 0 8rpx 24rpx rgba(51, 40, 36, 0.14);
  color: var(--paper);
  font-size: 20rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.camera-count-can {
  position: relative;
  width: 34rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border: 2rpx solid var(--coral);
  border-radius: 6rpx 6rpx 8rpx 8rpx;
  background: rgba(230, 126, 95, 0.88);
}

.camera-count-can::before {
  position: absolute;
  top: -8rpx;
  left: 4rpx;
  width: 22rpx;
  height: 8rpx;
  border: 2rpx solid var(--coral);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.88);
  content: '';
}

.camera-count-can::after {
  position: absolute;
  top: 8rpx;
  left: 12rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #9b442a;
  content: '';
}

.camera-count-value {
  margin-left: 12rpx;
  color: var(--coral);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.camera-mode {
  color: rgba(255, 253, 248, 0.78);
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.viewfinder-wrap {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.viewfinder {
  position: relative;
  display: flex;
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(140deg, #b7aa98 0%, #d8c8b3 43%, #70806a 100%);
}

.viewfinder::before {
  position: absolute;
  z-index: 0;
  inset: 0;
  background: linear-gradient(135deg, rgba(38, 32, 27, 0.32), transparent 45%), repeating-linear-gradient(90deg, transparent 0 82rpx, rgba(255, 253, 248, 0.08) 83rpx 84rpx);
  content: '';
}

.viewfinder::after {
  position: absolute;
  right: -100rpx;
  bottom: -160rpx;
  z-index: 0;
  width: 440rpx;
  height: 440rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.22);
  border-radius: 50%;
  box-shadow: 0 0 0 56rpx rgba(255, 253, 248, 0.08), 0 0 0 112rpx rgba(255, 253, 248, 0.05);
  content: '';
}

.camera-preview {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.camera-overlay {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
}

.viewfinder-frame {
  position: absolute;
  right: 44rpx;
  left: 44rpx;
  box-sizing: border-box;
  border: 2rpx dashed rgba(255, 253, 248, 0.7);
}

.viewfinder-corner {
  position: absolute;
  width: 46rpx;
  height: 46rpx;
  border-color: rgba(255, 253, 248, 0.94);
  border-style: solid;
}

.corner-top-left {
  top: -4rpx;
  left: -4rpx;
  border-width: 4rpx 0 0 4rpx;
}

.corner-top-right {
  top: -4rpx;
  right: -4rpx;
  border-width: 4rpx 4rpx 0 0;
}

.corner-bottom-left {
  bottom: -4rpx;
  left: -4rpx;
  border-width: 0 0 4rpx 4rpx;
}

.corner-bottom-right {
  right: -4rpx;
  bottom: -4rpx;
  border-width: 0 4rpx 4rpx 0;
}

.viewfinder-center-mark {
  position: absolute;
  top: 45%;
  left: 50%;
  width: 196rpx;
  height: 196rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.82);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.viewfinder-center-dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--coral);
  transform: translate(-50%, -50%);
}

.viewfinder-hint {
  position: absolute;
  bottom: 250rpx;
  left: 0;
  width: 100%;
  color: rgba(255, 253, 248, 0.92);
  font-size: 25rpx;
  text-align: center;
}

.camera-error-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(51, 40, 36, 0.56);
}

.camera-error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 470rpx;
  padding: 38rpx 28rpx 30rpx;
  border: 2rpx solid #d7c5b3;
  border-radius: 22rpx;
  background: rgba(255, 253, 249, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(51, 40, 36, 0.26);
  text-align: center;
}

.camera-error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  border: 2rpx solid #efb9a9;
  border-radius: 50%;
  background: #fff0e8;
  color: var(--coral);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
}

.camera-error-eyebrow {
  margin-top: 20rpx;
  color: var(--coral);
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.camera-error-title {
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.camera-error-subtitle {
  margin-top: 12rpx;
  color: #8c7569;
  font-size: 23rpx;
  line-height: 1.5;
}

.camera-error-button {
  margin-top: 24rpx;
  padding: 14rpx 34rpx;
  border-radius: 100rpx;
  background: var(--coral);
  color: #fff;
  font-size: 24rpx;
}

.bottom-bar {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 210rpx;
  min-height: 0;
  padding: 0 30rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: linear-gradient(transparent, rgba(38, 31, 27, 0.82) 45%);
}

.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  margin: 0;
  padding: 0;
  border: 0;
  color: rgba(255, 253, 248, 0.8);
  background: transparent;
  font-size: 19rpx;
  text-align: center;
  line-height: normal;
  box-sizing: border-box;
}

.bottom-action-label {
  color: inherit;
  font-size: inherit;
  line-height: 1.2;
}

.bottom-album-box,
.bottom-exit-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.56);
  background: rgba(51, 40, 36, 0.26);
}

.bottom-album-icon {
  width: 36rpx;
  height: 36rpx;
}

.bottom-exit-box {
  color: var(--coral);
  font-family: var(--font-display);
  font-size: 44rpx;
  line-height: 1;
}

.shutter-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 190rpx;
  margin-top: -18rpx;
}

.shutter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 154rpx;
  height: 154rpx;
  padding: 0;
  border: 10rpx solid rgba(255, 253, 248, 0.88);
  border-radius: 50%;
  background: var(--coral);
  box-shadow: 0 0 0 16rpx rgba(255, 253, 248, 0.14), 0 18rpx 36rpx rgba(51, 40, 36, 0.26);
  line-height: normal;
  box-sizing: border-box;
}

.shutter-btn:active {
  transform: scale(0.92);
}

.shutter-btn-busy {
  opacity: 0.55;
}

.shutter-camera-icon {
  width: 62rpx;
  height: 62rpx;
}

@media screen and (max-height: 700px) {
  .shutter-wrap {
    width: 164rpx;
    height: 164rpx;
  }

  .shutter-btn {
    width: 132rpx;
    height: 132rpx;
  }
}
