/* custom-tab-bar/index.wxss */
.custom-tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  flex-direction: row;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #fffaf4;
  box-shadow: 0 -8rpx 24rpx rgba(74, 55, 40, 0.06);
}

.custom-tabbar-line {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 2rpx;
  background: #eadfd4;
}

.custom-tabbar-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 132rpx;
}

.custom-tabbar-item-hover {
  opacity: 0.62;
}

.custom-tabbar-icon {
  display: block;
  width: 104rpx;
  height: 104rpx;
}
