/* pages/my/my.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  background: var(--surface);
  color: var(--ink);
}

.my-page {
  min-height: 100vh;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.my-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.my-content {
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
}

/* 未登录态：访客入口与登录后“我的相遇”页面保持同一套品牌语言。 */
.my-login-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.my-login-content {
  padding: 36rpx 36rpx 64rpx;
  box-sizing: border-box;
}

.my-login-kicker {
  display: block;
  margin-top: 0;
  margin-bottom: 14rpx;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.my-login-title {
  display: flex;
  flex-direction: column;
  margin-top: 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.08;
}

.my-login-title-em {
  color: var(--stamp);
}

.my-login-primary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 100% !important;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  margin-left: 0;
  margin-right: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.my-login-primary {
  height: 98rpx;
  border: 0;
  background: var(--stamp);
  box-shadow: 0 12rpx 0 rgba(155, 68, 42, 0.16);
  color: #fff;
}

.my-login-primary::after {
  border: 0;
}

.my-login-primary image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.my-login-primary-busy {
  opacity: 0.64;
}

.my-login-button-hover {
  opacity: 0.78;
  transform: translateY(2rpx);
}

.my-login-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.my-login-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.my-login-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.my-login-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.my-login-brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.my-login-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.my-login-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.my-login-guest-card {
  width: 100%;
  margin-top: 30rpx;
  padding: 20rpx 24rpx 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
  box-sizing: border-box;
}

.my-login-guest-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed var(--line);
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.my-login-guest-head text:last-child {
  flex-shrink: 0;
  color: var(--stamp);
  letter-spacing: 0;
}

.my-login-guest-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28rpx;
}

.my-login-guest-mark {
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  box-shadow: 0 8rpx 0 rgba(84, 69, 54, 0.08);
}

.my-login-guest-mark image {
  display: block;
  width: 100%;
  height: 100%;
}

.my-login-guest-title {
  display: block;
  margin-top: 20rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.my-login-guest-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.45;
  text-align: center;
}

.my-login-name-field {
  align-self: stretch;
  margin-top: 22rpx;
  padding: 16rpx 18rpx 18rpx;
  border: 2rpx solid var(--line);
  background: rgba(255, 253, 248, 0.74);
  box-sizing: border-box;
}

.my-login-name-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.my-login-name-label {
  color: var(--ink);
  font-size: 19rpx;
  font-weight: 700;
}

.my-login-name-hint {
  flex-shrink: 0;
  color: var(--muted-ink);
  font-size: 15rpx;
}

.my-login-name-input {
  display: block;
  width: 100%;
  height: 68rpx;
  margin-top: 12rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--ink);
  background: var(--surface);
  font-size: 20rpx;
  line-height: 68rpx;
  box-sizing: border-box;
}

.my-login-name-input-placeholder {
  color: #b8a79a;
}

.my-login-guest-body .my-login-primary {
  margin-top: 20rpx;
}

.my-login-feature-grid {
  display: flex;
  flex-direction: row;
  width: 100%;
  margin-top: 22rpx;
  border-bottom: 2rpx solid var(--line);
  box-sizing: border-box;
}

.my-login-feature {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 8rpx 20rpx;
  box-sizing: border-box;
}

.my-login-feature + .my-login-feature {
  border-left: 2rpx solid var(--line);
}

.my-login-feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  background: rgba(239, 210, 209, 0.78);
}

.my-login-feature-icon image {
  width: 28rpx;
  height: 28rpx;
}

.my-login-feature-title {
  display: block;
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.my-login-feature-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 15rpx;
  line-height: 1.2;
  text-align: center;
}

.my-login-guest-divider {
  width: 100%;
  margin-top: 26rpx;
  border-top: 2rpx dashed var(--line);
}

.my-login-explore {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 20rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  line-height: 1.3;
}

.my-login-explore-action {
  color: var(--stamp);
  font-weight: 700;
}

.my-login-bottom-safe {
  height: 26rpx;
}

.my-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.my-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.my-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.my-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.my-brand-copy {
  display: flex;
  flex-direction: column;
}

.my-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.my-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.my-page-kicker {
  display: block;
  margin-bottom: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.my-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--ink);
  font-size: 53rpx;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.my-title-em {
  color: var(--stamp);
}

.profile-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 34rpx;
  padding: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
}

.profile-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}

.profile-avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border: 8rpx solid var(--surface);
  border-radius: 16rpx;
  background: #d1b79a;
  box-shadow: 0 0 0 2rpx var(--line);
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
}

.profile-avatar-fallback {
  opacity: 0.82;
}

.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin: 6rpx 16rpx 0 20rpx;
}

.profile-name {
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  line-height: 1.15;
}

.profile-role {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
  line-height: 1.4;
}

.profile-level-badge {
  flex-shrink: 0;
  padding: 10rpx 12rpx;
  border: 2rpx solid var(--stamp);
  color: var(--stamp);
  background: var(--surface);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.profile-side {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
}

.profile-settings-button {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 86rpx;
  height: 48rpx;
  margin-top: 14rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--muted-ink);
  background: var(--surface);
  font-size: 16rpx;
  box-sizing: border-box;
}

.profile-settings-button:active {
  color: var(--stamp);
  border-color: var(--stamp);
  opacity: 0.76;
  transform: translateY(2rpx);
}

.profile-settings-glyph {
  color: var(--stamp);
  font-size: 20rpx;
  line-height: 1;
}

.profile-name-editor {
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.profile-name-editor-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.profile-name-editor-label {
  color: var(--ink);
  font-size: 18rpx;
  font-weight: 700;
}

.profile-name-editor-hint {
  color: var(--muted-ink);
  font-size: 15rpx;
}

.profile-name-editor-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.profile-name-editor-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--ink);
  background: var(--surface);
  font-size: 20rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.profile-name-editor-placeholder {
  color: #b8a79a;
}

.profile-name-editor-save {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 64rpx;
  border: 2rpx solid var(--stamp);
  border-radius: 14rpx;
  color: var(--stamp);
  background: var(--surface);
  font-size: 19rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.profile-name-editor-save-busy {
  opacity: 0.56;
}

.growth-module {
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.growth-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.growth-label {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.growth-label-title {
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
}

.growth-label-sub {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-value {
  flex-shrink: 0;
  color: var(--stamp);
  font-size: 28rpx;
  font-weight: 800;
}

.growth-value-total {
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 400;
}

.growth-track {
  position: relative;
  height: 16rpx;
  margin: 24rpx 12rpx 0 0;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: inset 0 0 0 2rpx rgba(51, 40, 36, 0.1);
}

.growth-track-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--stamp);
}

.growth-marker {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--stamp);
  border-radius: 50%;
  background: var(--surface);
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.growth-marker image {
  width: 23rpx;
  height: 23rpx;
}

.growth-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.growth-percent {
  color: var(--stamp);
  font-weight: 700;
}

.resource-card {
  padding: 20rpx 22rpx 22rpx;
  border: 2rpx solid var(--line);
  background: rgba(248, 241, 231, 0.72);
  box-sizing: border-box;
}

.resource-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 2rpx dashed rgba(215, 197, 179, 0.8);
}

.resource-card-kicker {
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.resource-card-hint {
  color: var(--muted-ink);
  font-size: 17rpx;
}

.resource-card-body {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding-top: 18rpx;
}

.resource-item {
  display: flex;
  flex: 1;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.resource-item-can {
  position: relative;
}

.resource-divider {
  width: 2rpx;
  margin: 0 18rpx;
  background: rgba(215, 197, 179, 0.72);
}

.resource-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  font-family: var(--font-display);
  font-size: 25rpx;
  font-weight: 800;
}

.resource-mark-can {
  background: #f2dfd3;
  color: var(--stamp);
}

.resource-mark-point {
  background: #e5ead9;
  color: #68764e;
}

.resource-item-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 12rpx;
}

.resource-can-recharge {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-left: 8rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.3);
  border-radius: 15rpx;
  background: rgba(241, 207, 132, 0.4);
}

.resource-can-recharge:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.resource-can-recharge image {
  width: 28rpx;
  height: 28rpx;
}

.resource-item-label {
  color: var(--ink);
  font-size: 19rpx;
  font-weight: 700;
}

.resource-item-value {
  margin-top: 2rpx;
  color: var(--stamp);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.05;
}

.resource-item-value-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  min-height: 34rpx;
}

.resource-item-unit {
  color: var(--muted-ink);
  font-size: 17rpx;
  font-weight: 400;
  margin-left: 5rpx;
}

.resource-item-note {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 16rpx;
}

.resource-item-breakdown {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-top: 7rpx;
}

.resource-breakdown-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  color: var(--muted-ink);
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
}

.resource-breakdown-item image {
  width: 23rpx;
  height: 23rpx;
  margin-right: 4rpx;
}

.resource-history-action {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  min-height: 32rpx;
  margin-left: 8rpx;
  gap: 2rpx;
}

.resource-history-count {
  display: flex;
  align-items: center;
  height: 32rpx;
  color: var(--muted-ink);
  font-size: 15rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.resource-history-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20rpx;
  height: 32rpx;
  margin-left: 5rpx;
  color: var(--muted-ink);
  font-size: 28rpx;
  line-height: 1;
  opacity: 0.62;
}

.profile-home-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 24rpx 0 18rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.28);
  background: rgba(255, 253, 248, 0.76);
  box-sizing: border-box;
}

.profile-home-entry:active {
  opacity: 0.78;
  transform: translateY(2rpx);
}

.profile-home-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: rgba(239, 210, 209, 0.72);
}

.profile-home-icon image {
  width: 32rpx;
  height: 32rpx;
}

.profile-home-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 14rpx;
}

.profile-home-kicker {
  color: var(--stamp);
  font-size: 14rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.profile-home-title {
  margin-top: 5rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.15;
}

.profile-home-subtitle {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 16rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-home-arrow {
  flex: none;
  margin-left: 12rpx;
  color: var(--stamp);
  font-size: 26rpx;
  font-weight: 700;
}

.sync-card {
  display: flex;
  flex-direction: row;
