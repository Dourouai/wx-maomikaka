<!-- 拍摄页：深色街拍取景器，保留原生 camera 能力 -->
<view class="camera-page">
  <view class="camera-topbar" style="top: {{cameraHeaderTop}}px; right: {{cameraHeaderRightInset}}px;">
    <view class="camera-count">
      <view class="camera-count-can"></view>
      <text>今日剩余罐罐</text>
      <text class="camera-count-value">{{remainingCans}} / {{dailyCanLimit}}</text>
    </view>
  </view>

  <view class="viewfinder-wrap">
    <view class="viewfinder">
      <camera
        id="cat-camera"
        class="camera-preview"
        device-position="back"
        flash="off"
        binderror="onCameraError"
      ></camera>

      <!-- camera 是原生组件，取景框装饰用 cover-view 保证始终显示在画面上层。 -->
      <cover-view class="camera-overlay">
        <cover-view class="viewfinder-frame" style="top: {{cameraFrameTop}}px; bottom: {{cameraFrameBottom}}px;">
          <cover-view class="viewfinder-corner corner-top-left"></cover-view>
          <cover-view class="viewfinder-corner corner-top-right"></cover-view>
          <cover-view class="viewfinder-corner corner-bottom-left"></cover-view>
          <cover-view class="viewfinder-corner corner-bottom-right"></cover-view>
        </cover-view>
        <cover-view class="viewfinder-center-mark">
          <cover-view class="viewfinder-center-dot"></cover-view>
        </cover-view>
        <cover-view class="viewfinder-hint" style="bottom: {{cameraHintBottom}}px;">它在这里 · 保持一点距离</cover-view>

        <!-- 真机中 camera 是原生组件，交互控件必须放在 cover-view 层才可稳定点击。 -->
        <cover-view class="bottom-bar" style="height: {{cameraControlsHeight}}px; padding-bottom: {{safeBottom}}px;">
          <cover-view class="bottom-action bottom-album" catchtap="goCollection" aria-role="button" aria-label="最近记录">
            <cover-view class="bottom-album-box">
              <cover-image class="bottom-album-icon" src="/assets/tab-album-active.png" />
            </cover-view>
            <cover-view class="bottom-action-label">最近记录</cover-view>
          </cover-view>

          <cover-view class="shutter-wrap">
            <cover-view
              class="shutter-btn {{isTakingPhoto ? 'shutter-btn-busy' : ''}}"
              catchtap="takePhoto"
              aria-role="button"
              aria-label="拍照"
            >
              <cover-image class="shutter-camera-icon" src="/assets/icon-camera-white.svg" />
            </cover-view>
          </cover-view>

          <cover-view class="bottom-action bottom-exit" catchtap="goBack" aria-role="button" aria-label="退出拍照">
            <cover-view class="bottom-exit-box">×</cover-view>
            <cover-view class="bottom-action-label">退出</cover-view>
          </cover-view>
        </cover-view>

      </cover-view>

      <cover-view wx:if="{{cameraError}}" class="camera-error-mask">
        <cover-view class="camera-error-card">
          <cover-view class="camera-error-icon"><cover-view>!</cover-view></cover-view>
          <cover-view class="camera-error-eyebrow">{{cameraIssueEyebrow}}</cover-view>
          <cover-view class="camera-error-title">{{cameraIssueTitle}}</cover-view>
          <cover-view class="camera-error-subtitle">{{cameraIssueSubtitle}}</cover-view>
          <cover-view class="camera-error-button" bindtap="handleCameraIssue">{{cameraIssueAction}}</cover-view>
        </cover-view>
      </cover-view>

      <cover-view wx:if="{{showLocationPrompt}}" class="location-consent-mask">
        <cover-view class="location-consent-card">
          <cover-view class="location-consent-eyebrow">OPTIONAL · LOCATION NOTE</cover-view>
          <cover-view class="location-consent-title">记录这次相遇的位置？</cover-view>
          <cover-view class="location-consent-subtitle">
            <cover-view>只记录本次相遇的大概位置</cover-view>
            <cover-view>不持续定位，也不参与猫咪识别。</cover-view>
          </cover-view>
          <cover-view class="location-consent-actions">
            <cover-view
              class="location-consent-button location-consent-primary {{locationConsentBusy ? 'location-consent-button-busy' : ''}}"
              catchtap="chooseLocationConsent"
            >{{locationConsentBusy ? '正在获取位置' : '记录大概位置'}}</cover-view>
            <cover-view
              class="location-consent-button location-consent-secondary"
              catchtap="skipLocationConsent"
            >暂不记录</cover-view>
          </cover-view>
        </cover-view>
      </cover-view>
    </view>
  </view>

</view>
