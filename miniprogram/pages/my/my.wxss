/* pages/my/my.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  background: var(--surface);
  color: var(--ink);
}

.my-page {
  min-height: 100vh;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.my-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.my-content {
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
}

/* 未登录态：按 city-cat-archive-v6 的 ACCESS / AUTH 页面排版。 */
.my-login-scroll {
  height: 100vh;
}

.my-login-content {
  padding: 36rpx 36rpx 64rpx;
  box-sizing: border-box;
}

.my-login-topline {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.my-login-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 36rpx;
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid var(--line);
}

.my-login-full-logo {
  display: block;
  flex: 1;
  width: 436rpx;
  height: 136rpx;
  min-width: 0;
}

.my-login-badge {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  min-height: 74rpx;
  padding: 10rpx 8rpx;
  border: 2rpx solid var(--line);
  color: var(--stamp);
  background: var(--paper);
  box-sizing: border-box;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  line-height: 1.35;
  text-align: center;
}

.my-login-divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.my-login-divider-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}

.my-login-kicker {
  display: block;
  margin-top: 36rpx;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.my-login-title {
  display: flex;
  flex-direction: column;
  margin-top: 14rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.13;
}

.my-login-title-em {
  color: var(--stamp);
}

.my-login-lead {
  display: block;
  max-width: 540rpx;
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  line-height: 1.55;
}

.my-login-access-card {
  width: 100%;
  margin-top: 32rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--line);
  background: rgba(255, 253, 248, 0.78);
  box-sizing: border-box;
}

.my-login-card-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--line);
}

.my-login-card-head text:first-child {
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
}

.my-login-card-head text:last-child {
  flex-shrink: 0;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.my-login-access-list {
  display: flex;
  flex-direction: column;
  padding-top: 4rpx;
}

.my-login-access-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 14rpx 0;
}

.my-login-access-row + .my-login-access-row {
  border-top: 2rpx dashed var(--line);
}

.my-login-access-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  background: var(--blush, #efd2d1);
}

.my-login-access-icon image {
  width: 30rpx;
  height: 30rpx;
}

.my-login-access-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.my-login-access-title {
  display: block;
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.25;
}

.my-login-access-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 16rpx;
  line-height: 1.4;
}

.my-login-access-status {
  flex-shrink: 0;
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  line-height: 1.2;
}

.my-login-scope-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-left: 4rpx solid var(--coral);
  background: rgba(239, 210, 209, 0.28);
  box-sizing: border-box;
}

.my-login-scope-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  background: var(--blush, #efd2d1);
}

.my-login-scope-icon image {
  width: 30rpx;
  height: 30rpx;
}

.my-login-scope-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.my-login-scope-title {
  display: block;
  color: var(--ink);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.25;
}

.my-login-scope-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 16rpx;
  line-height: 1.4;
}

.my-login-scope-status {
  flex-shrink: 0;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  line-height: 1.2;
}

.my-login-primary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 98rpx;
  margin-top: 28rpx;
  border-radius: 20rpx;
  background: var(--stamp);
  box-shadow: 0 12rpx 0 rgba(155, 68, 42, 0.16);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.my-login-primary image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.my-login-primary-busy {
  opacity: 0.64;
}

.my-login-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48rpx;
  padding-top: 12rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  line-height: 1.2;
}

.my-login-legal {
  margin: 18rpx 8rpx 0;
  color: var(--muted-ink);
  font-size: 16rpx;
  line-height: 1.55;
  text-align: center;
}

.my-login-legal-link {
  color: var(--stamp);
  text-decoration: underline;
}

.my-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.my-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.my-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.my-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.my-brand-copy {
  display: flex;
  flex-direction: column;
}

.my-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.my-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.my-page-kicker {
  display: block;
  margin-bottom: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.my-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--ink);
  font-size: 53rpx;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.my-title-em {
  color: var(--stamp);
}

.profile-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 34rpx;
  padding: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
}

.profile-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}

.profile-avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border: 8rpx solid var(--surface);
  border-radius: 50%;
  background: #d1b79a;
  box-shadow: 0 0 0 2rpx var(--line);
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  opacity: 0.82;
}

.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin: 6rpx 16rpx 0 20rpx;
}

.profile-name {
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  line-height: 1.15;
}

.profile-role {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
  line-height: 1.4;
}

.profile-level-badge {
  flex-shrink: 0;
  padding: 10rpx 12rpx;
  border: 2rpx solid var(--stamp);
  color: var(--stamp);
  background: var(--surface);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.growth-module {
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.growth-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.growth-label {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.growth-label-title {
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
}

.growth-label-sub {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-value {
  flex-shrink: 0;
  color: var(--stamp);
  font-size: 28rpx;
  font-weight: 800;
}

.growth-value-total {
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 400;
}

.growth-track {
  position: relative;
  height: 16rpx;
  margin: 24rpx 12rpx 0 0;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: inset 0 0 0 2rpx rgba(51, 40, 36, 0.1);
}

.growth-track-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--stamp);
}

.growth-marker {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--stamp);
  border-radius: 50%;
  background: var(--surface);
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.growth-marker image {
  width: 23rpx;
  height: 23rpx;
}

.growth-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.growth-percent {
  color: var(--stamp);
  font-weight: 700;
}

.stat-grid {
  display: flex;
  flex-direction: row;
  margin: 24rpx 0 36rpx;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 6rpx;
  border-right: 2rpx solid var(--line);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-align: center;
}

.sync-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin: 28rpx 0 36rpx;
  padding: 18rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-sizing: border-box;
}

.sync-card:active {
  opacity: 0.78;
  transform: translateY(2rpx);
}

.sync-card-busy {
  opacity: 0.7;
}

.sync-card-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: #efd2d1;
}

.sync-card-icon image {
  width: 34rpx;
  height: 34rpx;
}

.sync-card-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.sync-card-kicker {
  color: var(--stamp);
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.sync-card-title {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-card-subtitle {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-card-action {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  color: var(--stamp);
  font-size: 16rpx;
  font-weight: 700;
  white-space: nowrap;
}

.sync-card-arrow {
  margin-top: 3rpx;
  font-size: 25rpx;
  line-height: 1;
}

.ai-source-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border: 2rpx solid var(--line);
  background: rgba(241, 207, 132, 0.18);
  box-sizing: border-box;
}

.ai-source-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: rgba(201, 154, 73, 0.35);
}

.ai-source-icon image {
  width: 34rpx;
  height: 34rpx;
}

.ai-source-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.ai-source-title {
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ai-source-subtitle {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.35;
}

.ai-source-label {
  flex-shrink: 0;
  color: var(--stamp);
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: right;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.section-more {
  color: var(--stamp);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.record-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
}

.record-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #d7ae7e;
}

.record-dot image {
  width: 100%;
  height: 100%;
}

.record-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.record-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-date {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: var(--muted-ink);
  font-size: 16rpx;
}

.my-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.my-empty-mark {
  width: 78rpx;
  height: 78rpx;
  opacity: 0.3;
}

.my-empty-title {
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.my-empty-sub {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 21rpx;
}

.settings {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 36rpx;
}

.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--line);
  color: var(--ink);
  background: var(--paper);
  box-sizing: border-box;
}

.setting-row-link:active {
  opacity: 0.72;
  transform: translateY(2rpx);
}

.setting-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: var(--blush, #efd2d1);
}

.setting-icon image {
  width: 34rpx;
  height: 34rpx;
}

.setting-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.setting-title {
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}

.setting-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-arrow {
  flex-shrink: 0;
  color: var(--muted-ink);
  font-size: 34rpx;
  line-height: 1;
}

.dev-mode-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.24);
  background: var(--surface);
}

.dev-mode-entry:active,
.my-link:active {
  opacity: 0.78;
}

.dev-mode-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #efd2d1;
}

.dev-mode-entry-icon image {
  width: 46rpx;
  height: 46rpx;
}

.dev-mode-entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.dev-mode-entry-kicker {
  color: var(--stamp);
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.dev-mode-entry-title {
  margin-top: 5rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.dev-mode-entry-subtitle {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.dev-mode-entry-arrow,
.my-link-arrow {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}

.my-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 20rpx;
  background: var(--paper-deep);
}

.my-link-copy {
  display: flex;
  flex-direction: column;
}

.my-link-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.my-link-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
}

.my-bottom-safe {
  height: 26rpx;
}
