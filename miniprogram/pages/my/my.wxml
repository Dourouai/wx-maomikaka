<!-- 我的：城市猫咪观察手记 -->
<view class="my-page">
  <block wx:if="{{isLoggedIn}}">
  <scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="my-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="my-page-header" style="padding-right: {{headerRightInset}}px;">
        <view class="my-brand-mark">
          <view class="my-brand-symbol">
            <image src="/assets/tab-profile.svg" mode="aspectFit" />
          </view>
          <view class="my-brand-copy">
            <text class="my-brand-name">我的相遇</text>
            <text class="my-brand-sub">FIELD NOTES</text>
          </view>
        </view>
      </view>

      <text class="my-page-kicker">MY CAT JOURNAL</text>
      <view class="my-title">
        <text>留下每一次</text><text class="my-title-em">遇见</text>
      </view>

      <view class="profile-card">
        <view class="profile-top">
          <view class="profile-avatar-wrap">
            <image wx:if="{{profileAvatar}}" class="profile-avatar" src="{{profileAvatar}}" mode="aspectFill" binderror="onAvatarError" />
            <image wx:else class="profile-avatar profile-avatar-fallback" src="/assets/maomi-kaka-logo-square-144.png" mode="aspectFit" />
          </view>
          <view class="profile-copy">
            <text class="profile-name">{{profileName}}</text>
            <text class="profile-role">街角漫游者 · 记录生活里的猫</text>
          </view>
          <view class="profile-side">
            <text class="profile-level-badge">LV.{{memberLevel}}</text>
            <view class="profile-settings-button" bindtap="onProfileSettingsTap" aria-role="button" aria-label="设置头像和昵称">
              <text class="profile-settings-glyph">⚙</text>
              <text>设置</text>
            </view>
          </view>
        </view>

        <view class="growth-module">
          <view class="growth-head">
            <view class="growth-label">
              <text class="growth-label-title">猫爪成长经验</text>
              <text class="growth-label-sub">距离下一等级 {{nextMemberName}}</text>
            </view>
            <text class="growth-value">{{pawGrowth}} <text class="growth-value-total">/ {{nextGrowth}}</text></text>
          </view>
          <view class="growth-track">
            <view class="growth-track-fill" style="width: {{memberProgress}}%;"></view>
            <view
              class="growth-marker"
              style="left: {{memberProgress}}%; transform: translate(-{{memberProgress}}%, -50%);"
            >
              <image src="/assets/paw.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="growth-foot">
            <text>当前 LV.{{memberLevel}}</text>
            <text class="growth-percent">{{memberProgress}}% · 猫爪进度</text>
            <text wx:if="{{!memberIsMax}}">还差 {{growthToNext}} 猫爪</text>
            <text wx:else>继续城市冒险</text>
          </view>
        </view>
      </view>

      <view class="profile-home-entry" bindtap="goProfile" aria-role="button" aria-label="我的主页">
        <view class="profile-home-icon">
          <image src="/assets/icon-poster-share-coral.svg" mode="aspectFit" />
        </view>
        <view class="profile-home-copy">
          <text class="profile-home-kicker">MY PROFILE</text>
          <text class="profile-home-title">我的主页</text>
          <text class="profile-home-subtitle">分享你的猫卡，认识同样爱猫的人</text>
        </view>
        <text class="profile-home-arrow">→</text>
      </view>

      <view class="resource-card" aria-label="罐罐和咔咔分">
        <view class="resource-card-head">
          <text class="resource-card-kicker">MY RESOURCES</text>
          <text class="resource-card-hint">相遇资产</text>
        </view>
        <view class="resource-card-body">
          <view class="resource-item resource-item-can">
            <view class="resource-mark resource-mark-can"><text>罐</text></view>
            <view class="resource-item-copy">
              <text class="resource-item-label">罐罐</text>
              <view class="resource-item-value-row">
                <text class="resource-item-value">{{remainingCans}}</text>
                <text class="resource-item-unit">可用</text>
              </view>
              <view class="resource-item-breakdown">
                <view class="resource-breakdown-item" aria-label="今日赠送剩余 {{dailyRemainingCans}} 个">
                  <image src="/assets/icon-calendar-coral.svg" mode="aspectFit" />
                  <text>{{dailyRemainingCans}}</text>
                </view>
                <view class="resource-breakdown-item" aria-label="已购买剩余 {{purchasedCanBalance}} 个">
                  <image src="/assets/icon-can-coral.svg" mode="aspectFit" />
                  <text>{{purchasedCanBalance}}</text>
                </view>
              </view>
            </view>
            <view class="resource-can-recharge" bindtap="openCanRecharge" aria-role="button" aria-label="充值罐罐">
              <image src="/assets/icon-recharge-coral.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="resource-divider"></view>
          <view class="resource-item">
            <view class="resource-mark resource-mark-point"><text>咔</text></view>
            <view class="resource-item-copy">
              <text class="resource-item-label">咔咔分</text>
              <text class="resource-item-value">{{pointBalance}}</text>
              <text class="resource-item-note">累计余额</text>
            </view>
          </view>
        </view>
      </view>

      <view
        wx:if="{{showSyncEntry}}"
        class="sync-card {{syncBusy ? 'sync-card-busy' : ''}}"
        bindtap="onSyncTap"
        aria-role="button"
        aria-label="同步相遇记录"
      >
        <view class="sync-card-icon">
          <image src="/assets/doodle-spark.svg" mode="aspectFit" />
        </view>
        <view class="sync-card-copy">
          <text class="sync-card-kicker">{{syncKicker}}</text>
          <text class="sync-card-title">{{syncTitle}}</text>
          <text class="sync-card-subtitle">{{syncSubtitle}}</text>
        </view>
        <view class="sync-card-action">
          <text>{{syncActionText}}</text>
          <text class="sync-card-arrow">→</text>
        </view>
      </view>

      <view class="settings">
        <view class="setting-row setting-row-link" bindtap="goCatFriends" aria-role="button" aria-label="打开猫友图鉴">
          <view class="setting-icon">
            <image src="/assets/icon-heart.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">猫友图鉴</text>
            <text class="setting-subtitle">看看大家带着猫生图来串门</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
        <view class="setting-row setting-row-link resource-history-row" bindtap="openCanHistoryPage" aria-role="button" aria-label="查看罐罐使用记录">
          <view class="setting-icon">
            <image src="/assets/icon-history-coral.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">使用记录</text>
            <text class="setting-subtitle">查看最近的相遇使用</text>
          </view>
          <view class="resource-history-action">
            <text class="resource-history-count">{{canUsageTotal}} 次</text>
            <text class="resource-history-arrow">›</text>
          </view>
        </view>
        <view class="setting-row setting-row-link" bindtap="goAbout" aria-role="button" aria-label="打开关于猫咪咔咔">
          <view class="setting-icon">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">关于猫咪咔咔</text>
            <text class="setting-subtitle">认识我们的街角猫咪档案</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
        <view class="setting-row setting-row-link" bindtap="showFeedbackContact" aria-role="button" aria-label="功能建议及问题反馈">
          <view class="setting-icon">
            <image src="/assets/doodle-spark.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">功能建议及问题反馈</text>
            <text class="setting-subtitle">欢迎告诉我们你的想法和使用问题</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
      </view>

      <view class="my-bottom-safe"></view>
    </view>
  </scroll-view>
  </block>

  <block wx:else>
  <scroll-view class="my-scroll my-login-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="my-login-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="my-login-page-header">
        <view class="my-login-brand-mark">
          <view class="my-login-brand-symbol">
            <image src="/assets/icon-user-coral.svg" mode="aspectFit" />
          </view>
          <view class="my-login-brand-copy">
            <text class="my-login-brand-name">我的相遇</text>
            <text class="my-login-brand-sub">FIELD NOTES</text>
          </view>
        </view>
      </view>

      <text class="my-login-kicker">YOUR FIELD NOTES</text>
      <view class="my-login-title">
        <text>留住每一次<text class="my-login-title-em">遇见</text></text>
      </view>

      <view class="my-login-guest-card">
        <view class="my-login-guest-head">
          <text>CAT ARCHIVE · GUEST</text>
          <text>未登录</text>
        </view>
        <view class="my-login-guest-body">
          <view class="my-login-guest-mark">
            <image src="/assets/maomi-kaka-logo-square-144.png" mode="aspectFit" />
          </view>
          <text class="my-login-guest-title">登录，开启你的<text class="my-login-title-em">猫档案</text></text>
          <text class="my-login-guest-subtitle">先登录建立账号；头像和昵称可在资料卡的设置中选择保存。</text>
          <button
            class="my-login-primary {{syncBusy ? 'my-login-primary-busy' : ''}}"
            disabled="{{syncBusy}}"
            bindtap="onLoginTap"
            hover-class="my-login-button-hover"
            aria-role="button"
            aria-label="登录并绑定微信账号"
          >
            <image src="/assets/icon-user-white.svg" mode="aspectFit" />
            <text>{{syncBusy ? '正在登录' : '登录并绑定微信账号'}}</text>
          </button>
        </view>
      </view>

      <view class="my-login-feature-grid">
        <view class="my-login-feature">
          <view class="my-login-feature-icon">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <text class="my-login-feature-title">收录相遇</text>
          <text class="my-login-feature-subtitle">保存档案</text>
        </view>
        <view class="my-login-feature">
          <view class="my-login-feature-icon">
            <image src="/assets/paw.svg" mode="aspectFit" />
          </view>
          <text class="my-login-feature-title">积累猫爪</text>
          <text class="my-login-feature-subtitle">成长升级</text>
        </view>
        <view class="my-login-feature">
          <view class="my-login-feature-icon">
            <image src="/assets/tab-album-active.svg" mode="aspectFit" />
          </view>
          <text class="my-login-feature-title">查看图鉴</text>
          <text class="my-login-feature-subtitle">随时可查</text>
        </view>
      </view>

      <view class="my-login-guest-divider"></view>
      <view class="my-login-explore" bindtap="goCamera" aria-role="button" aria-label="去相遇">
        <text>也可以先逛逛</text>
        <text class="my-login-explore-action">去相遇 →</text>
      </view>

      <!-- 公开信息入口不依赖账号，未登录时也应可以查看。 -->
      <view class="settings my-login-public-settings">
        <view class="setting-row setting-row-link" bindtap="goCatFriends" aria-role="button" aria-label="打开猫友图鉴">
          <view class="setting-icon">
            <image src="/assets/icon-heart.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">猫友图鉴</text>
            <text class="setting-subtitle">看看大家带着猫生图来串门</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
        <view class="setting-row setting-row-link" bindtap="goAbout" aria-role="button" aria-label="打开关于猫咪咔咔">
          <view class="setting-icon">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">关于猫咪咔咔</text>
            <text class="setting-subtitle">认识我们的街角猫咪档案</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
        <view class="setting-row setting-row-link" bindtap="showFeedbackContact" aria-role="button" aria-label="功能建议及问题反馈">
          <view class="setting-icon">
            <image src="/assets/doodle-spark.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">功能建议及问题反馈</text>
            <text class="setting-subtitle">欢迎告诉我们你的想法和使用问题</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
      </view>

      <view class="my-login-bottom-safe"></view>
    </view>
  </scroll-view>
  </block>

  <!-- 仅在用户主动设置资料时展示；登录和记录同步都不读取微信头像和昵称。 -->
  <view
    wx:if="{{showProfileAuth}}"
    class="profile-auth-layer"
    catchtap="onProfileAuthCancel"
    aria-role="dialog"
    aria-label="设置头像和昵称"
  >
    <view class="profile-auth-backdrop"></view>
    <view class="profile-auth-card" catchtap="stopProfileAuthPropagation">
      <view class="profile-auth-head">
        <view>
          <text class="profile-auth-eyebrow">WECHAT PROFILE · SETTINGS</text>
          <text class="profile-auth-title">{{profileAuthTitle}}</text>
          <text class="profile-auth-subtitle">{{profileAuthSubtitle}}</text>
        </view>
        <view class="profile-auth-close" bindtap="onProfileAuthCancel" aria-role="button" aria-label="关闭资料填写">
          <image src="/assets/icon-close.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="profile-auth-form">
        <view class="profile-auth-avatar-field">
          <button
            class="profile-auth-avatar-button"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
            disabled="{{profileAuthBusy}}"
            aria-label="选择头像"
          >
            <image wx:if="{{profileAuthAvatarUrl}}" class="profile-auth-avatar" src="{{profileAuthAvatarUrl}}" mode="aspectFill" />
            <image wx:else class="profile-auth-avatar profile-auth-avatar-fallback" src="/assets/maomi-kaka-logo-square-144.png" mode="aspectFit" />
          </button>
          <text class="profile-auth-field-label">点击选择头像</text>
        </view>

        <view class="profile-auth-nickname-field">
          <text class="profile-auth-field-label">昵称</text>
          <input
            class="profile-auth-nickname-input"
            type="nickname"
            value="{{profileAuthNickname}}"
            maxlength="40"
            placeholder="点击输入框，从建议中选择"
            bindinput="onNicknameInput"
            confirm-type="done"
            disabled="{{profileAuthBusy}}"
          />
        </view>
      </view>

      <text class="profile-auth-note">登录和记录同步不读取资料；只有你点击设置并确认后，才会审核并保存头像和昵称。</text>

      <view class="profile-auth-actions">
        <view class="profile-auth-action profile-auth-cancel" bindtap="onProfileAuthCancel" aria-role="button">
          <text>取消</text>
        </view>
        <view class="profile-auth-action profile-auth-confirm {{profileAuthBusy ? 'profile-auth-confirm-busy' : ''}}" bindtap="onProfileAuthConfirm" aria-role="button">
          <text>{{profileAuthBusy ? '正在保存' : profileAuthConfirmText}}</text>
        </view>
      </view>
    </view>
  </view>

  <exception-modal
    visible="{{showException}}"
    eyebrow="{{exceptionEyebrow}}"
    title="{{exceptionTitle}}"
    message="{{exceptionMessage}}"
    primary-text="{{exceptionPrimaryText}}"
    bind:primary="onExceptionPrimary"
  />

  <view
    wx:if="{{showFeedbackContact}}"
    class="feedback-modal-layer"
    catchtap="stopFeedbackPropagation"
    aria-role="alertdialog"
    aria-label="功能建议及问题反馈"
  >
    <view class="feedback-modal-backdrop"></view>
    <view class="feedback-modal-card" catchtap="stopFeedbackPropagation">
      <view class="feedback-modal-symbol">
        <image src="/assets/doodle-spark.svg" mode="aspectFit" />
      </view>
      <text class="feedback-modal-eyebrow">FUNCTION NOTE · CONTACT</text>
      <text class="feedback-modal-title">功能建议及问题反馈</text>
      <text class="feedback-modal-message">欢迎添加微信：{{feedbackWechatId}} 告诉我们你的想法或遇到的问题</text>
      <text class="feedback-modal-detail">支持复制微信号，添加后即可反馈</text>
      <view class="feedback-modal-actions">
        <view class="feedback-modal-action feedback-modal-close" bindtap="closeFeedbackContact">
          <text>关闭</text>
        </view>
        <view class="feedback-modal-action feedback-modal-copy" bindtap="copyFeedbackContact">
          <text>复制</text>
        </view>
      </view>
    </view>
  </view>

  <view
    wx:if="{{showCanRecharge}}"
    class="recharge-layer"
    catchtap="stopRechargePropagation"
    aria-role="dialog"
    aria-label="充值罐罐"
  >
    <view class="recharge-backdrop"></view>
    <view class="recharge-card" catchtap="stopRechargePropagation">
      <view class="recharge-head">
        <view>
          <text class="recharge-eyebrow">CAN ARCHIVE · TOP UP</text>
          <text class="recharge-title">给罐罐加一点</text>
          <text class="recharge-subtitle">购买的罐罐会叠加到每日额度之外</text>
        </view>
        <view class="recharge-close" bindtap="closeCanRecharge" aria-role="button" aria-label="关闭充值">
          <image src="/assets/icon-close.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="recharge-plan-list">
        <view
          wx:for="{{rechargePlans}}"
          wx:key="id"
          class="recharge-plan {{selectedRechargePlanId === item.id ? 'recharge-plan-selected' : ''}}"
          data-plan-id="{{item.id}}"
          bindtap="selectRechargePlan"
          aria-role="radio"
          aria-label="{{item.priceText}}，{{item.note}}"
        >
          <view class="recharge-plan-icon">
            <image src="/assets/icon-can-coral.svg" mode="aspectFit" />
            <text>×{{item.canAmount}}</text>
          </view>
          <view class="recharge-plan-copy">
            <text class="recharge-plan-name">{{item.note}}</text>
            <text class="recharge-plan-unit">微信虚拟支付</text>
          </view>
          <view class="recharge-plan-price">
            <text>{{item.priceText}}</text>
            <text wx:if="{{item.tag}}" class="recharge-plan-tag">{{item.tag}}</text>
          </view>
          <view class="recharge-plan-check">
            <view wx:if="{{selectedRechargePlanId === item.id}}" class="recharge-plan-check-dot"></view>
          </view>
        </view>
      </view>

      <view class="recharge-submit {{rechargeBusy ? 'recharge-submit-busy' : ''}}" bindtap="confirmRecharge" aria-role="button" aria-label="确认充值">
        <image src="/assets/icon-recharge-coral.svg" mode="aspectFit" />
        <text>{{rechargeBusy ? '正在准备支付' : '确认充值 ¥' + selectedRechargePrice}}</text>
      </view>
      <text class="recharge-note">支付完成后，罐罐以微信发货通知确认到账</text>
    </view>
  </view>
</view>
