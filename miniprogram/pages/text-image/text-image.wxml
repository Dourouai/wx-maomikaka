<!-- 文字生图测试页：仅用于测试文生图模型，不写入猫卡。 -->
<navigation-bar title="文字生图实验室" back="{{true}}" color="#332824" background="#FFFDF8" />

<view class="text-image-page">
  <scroll-view class="text-image-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="text-image-content">
      <view class="text-image-hero">
        <view class="text-image-hero-tape"></view>
        <text class="text-image-kicker">TEXT → IMAGE</text>
        <text class="text-image-title">让一句话长出画面</text>
        <text class="text-image-subtitle">输入描述，试试看它会画出什么</text>
        <view class="text-image-note">
          <text>仅供开发测试，不会写入猫卡。</text>
        </view>
      </view>

      <view class="prompt-card">
        <view class="prompt-card-head">
          <view>
            <text class="prompt-card-kicker">YOUR PROMPT</text>
            <text class="prompt-card-title">你想画什么？</text>
          </view>
          <text class="prompt-card-count">{{promptLength}}/200</text>
        </view>

        <textarea
          class="prompt-input"
          value="{{prompt}}"
          maxlength="200"
          auto-height
          cursor-spacing="24"
          placeholder="例如：一只橘猫坐在窗台上看雨，暖黄色灯光"
          placeholder-class="prompt-placeholder"
          bindinput="onPromptInput"
        />

        <view class="prompt-presets">
          <text class="prompt-presets-label">试试这些</text>
          <view class="prompt-preset-list">
            <view
              wx:for="{{presets}}"
              wx:for-item="preset"
              wx:key="index"
              class="prompt-preset"
              bindtap="usePreset"
              data-prompt="{{preset}}"
            >
              <text>{{preset}}</text>
            </view>
          </view>
        </view>

        <view class="generate-button {{isGenerating ? 'generate-button-disabled' : ''}}" bindtap="generateImage">
          <image src="/assets/doodle-spark.svg" mode="aspectFit" />
          <text>{{isGenerating ? '正在画画…' : '开始生成'}}</text>
          <text class="generate-button-arrow">→</text>
        </view>
      </view>

      <view class="result-card">
        <view class="result-card-head">
          <view>
            <text class="result-card-kicker">MODEL RESULT</text>
            <text class="result-card-title">生成结果</text>
          </view>
          <text class="result-card-status">{{resultStatus}}</text>
        </view>

        <view wx:if="{{isGenerating}}" class="result-placeholder result-loading">
          <view class="result-loading-mark">
            <image src="/assets/doodle-spark.svg" mode="aspectFit" />
          </view>
          <text class="result-placeholder-title">小猫正在调色</text>
          <text class="result-placeholder-subtitle">通常需要一点时间，请不要关闭页面</text>
        </view>

        <view wx:elif="{{imagePath}}" class="result-image-wrap">
          <image class="result-image" src="{{imagePath}}" mode="aspectFit" />
          <view class="result-image-tag"><text>测试图片</text></view>
        </view>

        <view wx:else class="result-placeholder">
          <view class="result-placeholder-mark">✦</view>
          <text class="result-placeholder-title">这里会出现你的图片</text>
          <text class="result-placeholder-subtitle">先写一句描述，让画面开始发生</text>
        </view>

        <view wx:if="{{imagePath}}" class="result-meta">
          <text>模型：{{modelLabel}}</text>
          <text>仅供测试 · 不保存到猫卡</text>
        </view>
      </view>

      <view class="text-image-bottom-safe"></view>
    </view>
  </scroll-view>

  <exception-modal
    visible="{{showException}}"
    eyebrow="{{exceptionEyebrow}}"
    title="{{exceptionTitle}}"
    message="{{exceptionMessage}}"
    primary-text="{{exceptionPrimaryText}}"
    bind:primary="closeException"
  />
</view>
