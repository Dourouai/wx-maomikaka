<view class="home-page">
  <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="home-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="home-page-header" style="padding-right: {{headerRightInset}}px;">
        <view class="home-brand-mark">
          <view class="home-brand-symbol">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <view class="home-brand-copy">
            <text class="home-brand-name">猫咪咔咔</text>
            <text class="home-brand-sub">CITY CAT ARCHIVE</text>
          </view>
        </view>
      </view>

      <text class="home-kicker">CAT SPOTTER · PHOTO FIRST</text>
      <view class="home-title">
        <text>去遇见</text><text class="home-title-em">一只猫</text>
      </view>
      <text class="home-subtitle">带上罐罐，去街角走走吧</text>
      <text class="home-subtitle home-subtitle-line">把一场偶遇，变成一张相遇卡。</text>

      <view class="home-can-strip">
        <view class="home-can-copy">
          <text class="home-can-label">今日剩余罐罐</text>
          <view class="home-cans">
            <view wx:for="{{canSlots}}" wx:for-item="can" wx:key="index" class="home-can {{can ? '' : 'home-can-used'}}"></view>
          </view>
        </view>
        <text class="home-can-count">{{remainingCans}} / {{dailyCanLimit}}</text>
      </view>

      <view class="home-lens" bindtap="goCamera" aria-role="button" aria-label="进入拍照">
        <image class="home-lens-camera" src="/assets/icon-leica.svg" mode="aspectFit" />
        <text class="home-lens-label">把镜头对准街角</text>
      </view>

      <view class="primary-action" bindtap="goCamera" aria-role="button" aria-label="开始拍照">
        <image class="primary-action-camera" src="/assets/icon-camera-white.svg" mode="aspectFit" />
        <text class="primary-action-title">开始拍照</text>
      </view>

      <view class="home-note">
        <text>使用 1 个罐罐</text>
      </view>

      <view class="home-upload-entry" bindtap="goImageUpload" aria-role="button" aria-label="选择图片上传">
        <view class="home-upload-entry-icon">
          <image src="/assets/icon-album-white.svg" mode="aspectFit" />
        </view>
        <view class="home-upload-entry-copy">
          <text class="home-upload-entry-title">选择图片上传</text>
          <text class="home-upload-entry-subtitle">从相册选择，进入和拍摄相同的识别流程</text>
        </view>
        <image class="home-upload-entry-arrow" src="/assets/icon-arrow-right-coral.svg" mode="aspectFit" />
      </view>

      <view class="home-bottom-safe"></view>
    </view>
  </scroll-view>

  <exception-modal
    visible="{{showException}}"
    eyebrow="{{exceptionEyebrow}}"
    title="{{exceptionTitle}}"
    message="{{exceptionMessage}}"
    primary-text="{{exceptionPrimaryText}}"
    secondary-text="{{exceptionSecondaryText}}"
    show-secondary="{{showExceptionSecondary}}"
    bind:primary="onExceptionPrimary"
    bind:secondary="onExceptionSecondary"
  />
</view>
