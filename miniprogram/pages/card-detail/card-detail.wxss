/* pages/card-detail/card-detail.wxss · city-cat-archive-v5 */
page {
  --ink: #332824;
  --muted: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  --blush: #efd2d1;
  background: var(--paper);
}

.detail-page {
  min-height: 100vh;
  color: var(--ink);
  background-color: var(--paper);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.detail-scroll {
  height: 100vh;
}

.detail-content {
  padding: 34rpx 28rpx 0;
  box-sizing: border-box;
}

.file-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 0 2rpx 26rpx;
  box-sizing: border-box;
}

.shared-state {
  display: flex;
  align-items: center;
  flex-direction: column;
  margin: 86rpx 10rpx 0;
  padding: 52rpx 30rpx;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--surface);
  box-shadow: 0 10rpx 0 rgba(51, 40, 36, 0.06);
  text-align: center;
}

.shared-state-kicker {
  color: var(--stamp);
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.shared-state-title {
  margin-top: 18rpx;
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 800;
}

.shared-state-copy {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.6;
}

.shared-state-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin-top: 28rpx;
  border-radius: 18rpx;
  color: var(--surface);
  background: var(--stamp);
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 0 rgba(75, 29, 18, 0.12);
}

.shared-state-action:active {
  transform: translateY(3rpx);
}

.file-back {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--stamp);
  background: var(--surface);
  box-sizing: border-box;
}

.file-back-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
}

.file-heading {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.file-kicker {
  margin-bottom: 7rpx;
  overflow: hidden;
  color: var(--stamp);
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-title {
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-photo-poster-action {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 4;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.34);
  border-radius: 22rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 6rpx 12rpx rgba(51, 40, 36, 0.1);
  box-sizing: border-box;
}

.file-photo-poster-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.file-photo-poster-action-ready {
  border-color: rgba(155, 68, 42, 0.56);
  background: rgba(255, 253, 248, 0.98);
}

.file-photo-poster-action-disabled {
  opacity: 0.48;
}

.file-photo-poster-action:active {
  transform: translateY(2rpx);
}

.file-hero {
  padding: 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--surface);
  box-shadow: 0 10rpx 0 rgba(51, 40, 36, 0.06);
  box-sizing: border-box;
}

.file-photo {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  /* detail-content 及 file-hero 的内边距合计 92rpx，让主体图区域保持 1:1。 */
  height: calc(100vw - 92rpx);
  overflow: hidden;
  border: 2rpx solid rgba(215, 197, 179, 0.62);
  border-radius: 22rpx;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.08) 1rpx, transparent 1rpx);
  background-size: 24rpx 24rpx;
  box-sizing: border-box;
}

.file-photo-corner {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  border-top: 4rpx solid var(--line);
  border-left: 4rpx solid var(--line);
  box-sizing: border-box;
}

.file-photo-stamp {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  z-index: 2;
  color: rgba(140, 117, 105, 0.72);
  font-size: 14rpx;
  letter-spacing: 2rpx;
}

.file-photo-image {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
}

.file-photo-placeholder {
  position: relative;
  z-index: 1;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.55;
}

.file-photo-label {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin: 16rpx 8rpx 0;
  padding: 16rpx 20rpx 14rpx;
  border: 2rpx solid rgba(215, 197, 179, 0.92);
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 10rpx 24rpx rgba(51, 40, 36, 0.1);
}

.file-photo-code {
  color: var(--stamp);
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.file-name-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.file-name {
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-name-code {
  flex: none;
  color: var(--muted);
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.file-breed {
  overflow: hidden;
  color: var(--muted);
  font-size: 14rpx;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 16rpx 4rpx 0;
}

.file-tag {
  padding: 8rpx 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  background: var(--paper);
  font-size: 16rpx;
  line-height: 1;
}

.file-tag:nth-child(1) {
  color: var(--stamp);
  background: rgba(239, 210, 209, 0.62);
}

.file-tag:nth-child(2) {
  color: #936622;
  background: rgba(241, 207, 132, 0.42);
}

.file-tag:nth-child(3) {
  color: #4a6549;
  background: rgba(205, 225, 200, 0.62);
}

.file-data {
  display: flex;
  padding: 18rpx 4rpx 2rpx;
  margin-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.file-data-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 0 12rpx;
  border-right: 2rpx solid var(--line);
  color: var(--muted);
  font-size: 16rpx;
  box-sizing: border-box;
}

.file-data-item:first-child {
  padding-left: 0;
}

.file-data-item:last-child {
  padding-right: 0;
  border-right: 0;
}

.file-data-value {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 16rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-section {
  margin-top: 30rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-family: var(--font-display);
  font-size: 32rpx;
  font-weight: 800;
}

.section-code {
  color: var(--stamp);
  font-size: 15rpx;
  letter-spacing: 1rpx;
}

.field-note-card {
  padding: 26rpx 24rpx 24rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: rgba(239, 210, 209, 0.24);
}

.field-note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 700;
}

.field-note-head text:last-child {
  color: var(--muted);
  font-size: 16rpx;
  font-weight: 400;
}

.field-note-copy {
  display: block;
  margin: 20rpx 0 24rpx;
  font-family: var(--font-display);
  font-size: 27rpx;
  line-height: 1.7;
}

.field-note-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--muted);
  font-size: 16rpx;
}

.score-card {
  padding: 20rpx 22rpx;
  border: 2rpx solid var(--line);
  background: linear-gradient(90deg, rgba(241, 207, 132, 0.25), rgba(239, 210, 209, 0.25));
}

.score-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.score-context {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.score-context-title {
  overflow: hidden;
  font-family: var(--font-display);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-total {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
}

.score-total-label {
  color: var(--muted);
  font-size: 16rpx;
}

.score-total-value {
  margin-top: 2rpx;
  color: var(--coral);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
}

.score-list {
  margin-top: 18rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.score-row:first-child {
  margin-top: 0;
}

.score-label {
  flex: none;
  width: 60rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.score-track {
  flex: 1;
  height: 10rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(140, 117, 105, 0.18);
}

.score-fill {
  height: 100%;
  min-width: 4rpx;
  border-radius: inherit;
  background: var(--coral);
}

/* 与 posterCanvas / 猫友图鉴使用同一套等级色。 */
.score-fill-C { background: #8fa783; }
.score-fill-U { background: #9a8aa9; }
.score-fill-R { background: #b78445; }
.score-fill-SR { background: #b96b65; }
.score-fill-UR { background: #665378; }

.score-value {
  flex: none;
  width: 44rpx;
  font-size: 18rpx;
  font-weight: 700;
  text-align: right;
}

.score-empty {
  display: block;
  margin-top: 18rpx;
  color: var(--muted);
  font-size: 18rpx;
}

.score-repair-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.28);
  border-radius: 999rpx;
  color: var(--stamp);
  background: rgba(255, 253, 248, 0.42);
  font-size: 17rpx;
}

.score-repair-action:active {
  opacity: 0.72;
}

.score-repair-error {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 16rpx;
}

.score-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 14rpx;
  margin-top: 16rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--muted);
  font-size: 16rpx;
}

.score-footer text:last-child {
  color: var(--stamp);
  font-weight: 700;
  text-align: right;
}

.file-timeline {
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.file-encounter {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 15rpx 16rpx;
  border-bottom: 2rpx dashed var(--line);
  background: rgba(255, 253, 248, 0.44);
}

.file-encounter:last-child {
  border-bottom: 0;
}

.file-encounter-featured {
  background: rgba(239, 210, 209, 0.24);
}

.file-encounter-index {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  color: var(--stamp);
  background: var(--blush);
  font-size: 16rpx;
}

.file-encounter-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.file-encounter-title {
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-encounter-meta {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-encounter-side {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  color: var(--muted);
  font-size: 16rpx;
}

.file-featured-mark {
  color: var(--stamp);
  font-size: 15rpx;
  font-weight: 700;
}

.file-actions {
  margin-top: 26rpx;
}

.file-primary {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  width: 100%;
  min-width: 0;
  max-width: none;
  min-height: 102rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 20rpx;
  color: var(--surface);
  background: var(--stamp);
  box-shadow: 0 14rpx 0 rgba(75, 29, 18, 0.12);
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1;
  box-sizing: border-box;
}

.file-primary::after {
  border: 0;
}

.file-primary-icon {
  font-size: 24rpx;
}

.file-visibility-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 86rpx;
  margin-top: 18rpx;
  padding: 0 18rpx 0 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  background: rgba(248, 241, 231, 0.62);
  box-sizing: border-box;
}

.file-visibility-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-right: 16rpx;
}

.file-visibility-title {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
}

.file-visibility-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 16rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-visibility-error {
  display: block;
  margin: 10rpx 4rpx 0;
  color: var(--stamp);
  font-size: 16rpx;
}

.file-action-note {
  display: block;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 14rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

.file-release {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  min-height: 82rpx;
  margin-top: 18rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  color: var(--stamp);
  background: transparent;
  box-sizing: border-box;
}

.file-release-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.9;
}

.file-release-copy {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.file-release-title {
  color: var(--stamp);
  font-size: 28rpx;
  font-weight: 750;
  line-height: 1;
  white-space: nowrap;
}

.file-release:active {
  opacity: 0.72;
  transform: translateY(2rpx);
}

.delete-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
}

.delete-dim {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(51, 40, 36, 0.6);
}

.delete-dialog {
  position: absolute;
  top: 50%;
  right: 36rpx;
  left: 36rpx;
  padding: 38rpx 28rpx 32rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-shadow: 0 26rpx 56rpx rgba(51, 40, 36, 0.26);
  text-align: center;
  transform: translateY(-50%);
  box-sizing: border-box;
}

.delete-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.35);
  border-radius: 50%;
  background: var(--blush);
}

.delete-symbol image {
  width: 38rpx;
  height: 38rpx;
}

.delete-eyebrow {
  display: block;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 2.56rpx;
}

.delete-title {
  display: block;
  margin: 18rpx 0 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.delete-message {
  display: block;
  margin: 14rpx 0 0;
  color: var(--muted);
  font-family: var(--font-display);
  font-size: 20rpx;
  line-height: 1.5;
}

.delete-detail {
  display: block;
  padding-top: 16rpx;
  margin-top: 18rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--muted);
  font-size: 18rpx;
}

.delete-error {
  display: block;
  margin-top: 14rpx;
  color: var(--stamp);
  font-size: 18rpx;
}

.delete-actions {
  display: flex;
  flex-direction: row;
  gap: 14rpx;
  margin-top: 28rpx;
}

.delete-button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--line);
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.delete-button-cancel {
  color: var(--stamp);
  background: var(--paper);
}

.delete-button-confirm {
  border-color: var(--stamp);
  color: var(--surface);
  background: var(--stamp);
}

.delete-button:active {
  opacity: 0.82;
}

.detail-bottom-safe {
  height: calc(58rpx + env(safe-area-inset-bottom));
}

@media (max-width: 340px) {
  .detail-content {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .file-name {
    font-size: 32rpx;
  }

  .file-data-item,
  .file-data-value,
  .score-footer {
    font-size: 14rpx;
  }
}
