<!-- 猫卡：街角猫档案索引 -->
<view class="collection-page">
  <scroll-view
    class="collection-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{isRefreshing}}"
    refresher-background="#f8f1e5"
    bindrefresherrefresh="onPullDownRefresh"
    scroll-top="{{scrollTop}}"
    bindscrolltolower="onScrollToLower"
  >
    <view class="collection-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="album-page-header" style="padding-right: {{headerRightInset}}px;">
        <view class="album-brand-mark">
          <view class="album-brand-symbol">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <view class="album-brand-copy">
            <text class="album-brand-name">猫咪咔咔</text>
            <text class="album-brand-sub">CITY CAT ARCHIVE</text>
          </view>
        </view>
      </view>

      <text class="album-page-kicker">ARCHIVE INDEX · LIVING INDEX</text>
      <view class="album-title">
        <text>我的</text><text class="album-title-em">猫卡</text>
      </view>

      <view class="album-count-row">
        <text class="album-count-value">已发现 {{unlockedCount}} 只</text>
        <text class="album-count-code">NO FIXED TOTAL</text>
      </view>

      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-list">
          <view
            wx:for="{{filterOptions}}"
            wx:for-item="filter"
            wx:key="value"
            class="filter-chip {{activeFilter === filter.value ? 'filter-chip-active' : ''}}"
            bindtap="switchFilter"
            data-value="{{filter.value}}"
            aria-role="button"
            aria-label="{{filter.label}} {{filter.count}}"
          >
            <text>{{filter.label}}</text>
            <text class="filter-count">{{filter.count}}</text>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{filteredList.length > 0}}" class="album-grid">
        <view
          wx:for="{{pagedList}}"
          wx:for-item="cat"
          wx:key="id"
          class="album-entry"
          bindtap="goDetail"
          data-cat-id="{{cat.id}}"
          data-unlocked="{{cat.unlocked}}"
          aria-role="button"
          aria-label="打开 {{cat.displayName}}"
        >
          <view class="cat-portrait cat-portrait-{{cat.levelCode}}">
            <block wx:if="{{cat.photoPath}}">
              <image class="cat-photo" src="{{cat.photoPath}}" mode="aspectFit" />
            </block>
            <image wx:else class="cat-photo-fallback" src="/assets/cat-placeholder.svg" mode="aspectFit" />

            <view class="level-mark level-mark-{{cat.levelCode}}">
              <text class="level-mark-code">{{cat.levelCode}}</text>
              <text>{{cat.levelLabel}}</text>
            </view>
            <view wx:if="{{cat.isNew}}" class="new-mark">NEW</view>
          </view>

          <view class="cat-label">
            <text class="cat-label-name">{{cat.displayName}}</text>
            <text class="cat-label-meta">{{cat.levelCode}} · {{cat.levelLabel}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{totalPages > 1}}" class="collection-pagination">
        <view
          class="pagination-action {{currentPage <= 1 ? 'pagination-action-disabled' : ''}}"
          bindtap="changePage"
          data-page="{{currentPage - 1}}"
          aria-role="button"
          aria-label="上一页"
        >
          <text>上一页</text>
        </view>
        <text class="pagination-status">{{currentPage}} / {{totalPages}}</text>
        <view
          class="pagination-action {{currentPage >= totalPages ? 'pagination-action-disabled' : ''}}"
          bindtap="changePage"
          data-page="{{currentPage + 1}}"
          aria-role="button"
          aria-label="下一页"
        >
          <text>下一页</text>
        </view>
      </view>

      <view wx:if="{{filteredList.length === 0}}" class="empty-album">
        <image class="empty-album-mark" src="/assets/cat-placeholder.svg" mode="aspectFit" />
        <text class="empty-album-title">这里还没有猫咪</text>
        <text class="empty-album-sub">去相遇，留下第一张档案</text>
      </view>

      <view class="album-footnote">
        <text wx:if="{{totalPages > 1}}">每页 12 张猫卡 · 点击上一页或下一页继续查看</text>
        <text wx:else>轻轻滑动，继续发现城市里的猫</text>
      </view>
      <view class="collection-bottom-safe"></view>
    </view>
  </scroll-view>

  <exception-modal
    visible="{{showException}}"
    eyebrow="{{exceptionEyebrow}}"
    title="{{exceptionTitle}}"
    message="{{exceptionMessage}}"
    primary-text="{{exceptionPrimaryText}}"
    bind:primary="onExceptionPrimary"
  />
</view>
