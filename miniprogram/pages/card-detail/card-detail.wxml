<!-- 猫档案：city-cat-archive-v5 -->

<view class="detail-page">
  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="detail-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="file-header" style="padding-right: {{headerRightInset}}px;">
        <view class="file-back" bindtap="goBack" aria-role="button" aria-label="{{returnAriaLabel}}">
          <image class="file-back-icon" src="/assets/icon-chevron-left-coral.svg" mode="aspectFit" />
        </view>
        <view class="file-heading">
          <text class="file-kicker">CAT FILE · NO.{{archiveCode}}</text>
          <text class="file-title">猫档案</text>
        </view>
      </view>

      <view wx:if="{{shareLoading}}" class="shared-state shared-state-loading">
        <text class="shared-state-kicker">CAT ARCHIVE · SHARED</text>
        <text class="shared-state-title">正在打开猫咪档案</text>
        <text class="shared-state-copy">把这次街角相遇整理好，很快就能看见了。</text>
      </view>

      <view wx:elif="{{shareError}}" class="shared-state shared-state-error">
        <text class="shared-state-kicker">CAT ARCHIVE · UNAVAILABLE</text>
        <text class="shared-state-title">{{shareError}}</text>
        <text class="shared-state-copy">这份公开档案可能已经失效或设为私密，云端暂时没有响应时也会显示在这里。</text>
        <view class="shared-state-action" bindtap="goCollection" aria-role="button" aria-label="{{returnAriaLabel}}">
          <text>{{returnLabel}}</text>
        </view>
      </view>

      <block wx:if="{{catData && !shareLoading}}">
        <view class="file-hero">
          <view class="file-photo">
            <view class="file-photo-corner"></view>
            <text class="file-photo-stamp">CAT ARCHIVE</text>
            <image wx:if="{{featuredPhoto}}" class="file-photo-image" src="{{featuredPhoto}}" mode="aspectFit" />
            <image wx:else class="file-photo-placeholder" src="/assets/cat-placeholder.svg" mode="aspectFit" />
            <view
              wx:if="{{catData && !shareLoading && !isPublicGalleryArchive}}"
              class="file-photo-poster-action file-photo-poster-action-{{posterEligible ? 'ready' : 'disabled'}}"
              bindtap="openPoster"
              aria-role="button"
              aria-label="生成海报"
            >
              <image class="file-photo-poster-action-icon" src="/assets/icon-poster-share-coral.svg" mode="aspectFit" />
            </view>
          </view>

          <view class="file-photo-label">
            <text class="file-photo-code">ARCHIVE #{{archiveCode}}</text>
            <view class="file-name-row">
              <text class="file-name">{{catData.name}}</text>
              <text class="file-name-code">{{currentSourceType}}</text>
            </view>
            <text class="file-breed">CITY CAT · {{catData.breed}}</text>
          </view>

          <view class="file-tags" aria-label="相遇标签">
            <text class="file-tag">{{catData.breed}}</text>
            <text wx:for="{{catData.trait}}" wx:for-item="trait" wx:key="index" class="file-tag">{{trait}}</text>
          </view>

          <view class="file-data">
            <view class="file-data-item">
              <text>首次遇见</text>
              <text class="file-data-value">{{firstSeenText}}</text>
            </view>
            <view wx:if="{{hasLocation}}" class="file-data-item">
              <text>出没位置：</text>
              <text class="file-data-value">{{locationText}}</text>
            </view>
          </view>
        </view>

        <view class="file-section score-section">
          <view class="section-heading">
            <text class="section-title">猫卡</text>
            <text class="section-code">CAT SCORE</text>
          </view>
          <view class="score-card">
            <view class="score-head">
              <view class="score-context">
                <text class="score-context-title">{{currentLevelCode}} · {{currentLevelLabel}}</text>
              </view>
              <view class="score-total">
                <text class="score-total-label">咪咔</text>
                <text class="score-total-value">{{currentOverallScoreText}}</text>
              </view>
            </view>

            <view wx:if="{{currentScoreItems.length > 0}}" class="score-list">
              <view wx:for="{{currentScoreItems}}" wx:for-item="score" wx:key="key" class="score-row">
                <text class="score-label">{{score.label}}</text>
                <view class="score-track">
                  <view class="score-fill score-fill-{{currentLevelCode}}" style="width: {{score.value}}%;"></view>
                </view>
                <text class="score-value">{{score.value}}</text>
              </view>
            </view>
            <text wx:else class="score-empty">这次相遇暂未完成评分</text>
            <view
              wx:if="{{currentScorePending && currentOriginalFileID && !isSharedArchive}}"
              class="score-repair-action"
              bindtap="repairCurrentScore"
              aria-role="button"
              aria-label="补回这次评分"
            >
              <text>{{scoreRepairBusy ? '正在补评分…' : '补回这次评分'}}</text>
            </view>
            <text wx:if="{{scoreRepairError}}" class="score-repair-error">{{scoreRepairError}}</text>

            <view class="score-footer">
              <text>当前猫咪 · 满分 100</text>
              <text wx:if="{{currentPawReward !== null}}">猫爪 +{{currentPawReward}} · 咔咔分 +{{currentPointReward}}</text>
              <text wx:else>每次相遇单独计算</text>
            </view>
          </view>
        </view>

        <view class="file-section field-notes">
          <view class="section-heading">
            <text class="section-title">手记</text>
            <text class="section-code">FIELD NOTES</text>
          </view>
          <view class="field-note-card">
            <view class="field-note-head">
              <text>{{fieldNoteDate}}</text>
            </view>
            <text class="field-note-copy">“{{fieldNoteText}}”</text>
            <view class="field-note-meta">
              <text>{{catData.breed}}</text>
              <text>{{currentLevelCode}} · {{currentLevelLabel}}</text>
              <text>已收入档案</text>
            </view>
          </view>
        </view>

        <view class="file-actions">
          <view class="file-primary" bindtap="goCollection" aria-role="button" aria-label="{{returnAriaLabel}}">
            <text class="file-primary-icon">▣</text>
            <text>{{returnLabel}}</text>
          </view>
          <view wx:if="{{!isSharedArchive}}" class="file-visibility-setting">
            <view class="file-visibility-copy">
              <text class="file-visibility-title">猫友串门</text>
              <text class="file-visibility-subtitle">{{visibilityPublic ? '带着猫生图去和大家见面' : '先在自己的档案里安静待着'}}</text>
            </view>
            <switch
              checked="{{visibilityPublic}}"
              disabled="{{visibilityBusy}}"
              color="#9b442a"
              bindchange="onVisibilityChange"
              aria-label="允许这只猫去猫友图鉴串门"
            />
          </view>
          <text wx:if="{{visibilityError}}" class="file-visibility-error">{{visibilityError}}</text>
          <view wx:if="{{!isSharedArchive}}" class="file-release" bindtap="openDeleteConfirm" aria-role="button" aria-label="放归这只猫">
            <image class="file-release-icon" src="/assets/icon-trash-coral.svg" mode="aspectFit" />
            <view class="file-release-copy">
              <text class="file-release-title">放归自由</text>
            </view>
          </view>
          <text class="file-action-note">CITY CAT ARCHIVE · NO.{{archiveCode}}</text>
        </view>
      </block>

      <view class="detail-bottom-safe"></view>
    </view>
  </scroll-view>

  <view wx:if="{{showDeleteConfirm}}" class="delete-overlay" catchtap="stopDeletePropagation">
    <view class="delete-dim"></view>
    <view class="delete-dialog" catchtap="stopDeletePropagation" aria-role="alertdialog" aria-label="删除相遇卡确认">
      <view class="delete-symbol">
        <image src="/assets/icon-trash-coral.svg" mode="aspectFit" />
      </view>
      <text class="delete-eyebrow">ARCHIVE ACTION · DELETE</text>
      <text class="delete-title">要放归这只猫吗？</text>
      <text class="delete-message">确认后，这张相遇卡会从你的图鉴中移除。</text>
      <text class="delete-detail">之后仍可以再次遇见它</text>
      <text wx:if="{{deleteError}}" class="delete-error">{{deleteError}}</text>
      <view class="delete-actions">
        <view class="delete-button delete-button-cancel" bindtap="cancelDelete">
          <text>保留档案</text>
        </view>
        <view class="delete-button delete-button-confirm" bindtap="confirmDelete">
          <text>{{deleteBusy ? '正在放归…' : '放归'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
