/* pages/my/my.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  background: var(--surface);
  color: var(--ink);
}

.my-page {
  min-height: 100vh;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.my-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.my-content {
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
}

/* 未登录态：访客入口与登录后“我的相遇”页面保持同一套品牌语言。 */
.my-login-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.my-login-content {
  padding: 36rpx 36rpx 64rpx;
  box-sizing: border-box;
}

.my-login-kicker {
  display: block;
  margin-top: 0;
  margin-bottom: 14rpx;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.my-login-title {
  display: flex;
  flex-direction: column;
  margin-top: 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.08;
}

.my-login-title-em {
  color: var(--stamp);
}

.my-login-primary {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 100% !important;
  max-width: 100%;
  min-width: 0;
  margin: 0;
  margin-left: 0;
  margin-right: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.my-login-primary {
  height: 98rpx;
  border: 0;
  background: var(--stamp);
  box-shadow: 0 12rpx 0 rgba(155, 68, 42, 0.16);
  color: #fff;
}

.my-login-primary::after {
  border: 0;
}

.my-login-primary image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.my-login-primary-busy {
  opacity: 0.64;
}

.my-login-button-hover {
  opacity: 0.78;
  transform: translateY(2rpx);
}

.my-login-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.my-login-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.my-login-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.my-login-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.my-login-brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.my-login-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.my-login-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.my-login-guest-card {
  width: 100%;
  margin-top: 30rpx;
  padding: 20rpx 24rpx 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
  box-sizing: border-box;
}

.my-login-guest-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed var(--line);
  color: var(--muted-ink);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.my-login-guest-head text:last-child {
  flex-shrink: 0;
  color: var(--stamp);
  letter-spacing: 0;
}

.my-login-guest-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28rpx;
}

.my-login-guest-mark {
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  box-shadow: 0 8rpx 0 rgba(84, 69, 54, 0.08);
}

.my-login-guest-mark image {
  display: block;
  width: 100%;
  height: 100%;
}

.my-login-guest-title {
  display: block;
  margin-top: 20rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}

.my-login-guest-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.45;
  text-align: center;
}

.my-login-guest-body .my-login-primary {
  margin-top: 26rpx;
}

.my-login-feature-grid {
  display: flex;
  flex-direction: row;
  width: 100%;
  margin-top: 22rpx;
  border-bottom: 2rpx solid var(--line);
  box-sizing: border-box;
}

.my-login-feature {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 8rpx 20rpx;
  box-sizing: border-box;
}

.my-login-feature + .my-login-feature {
  border-left: 2rpx solid var(--line);
}

.my-login-feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  background: rgba(239, 210, 209, 0.78);
}

.my-login-feature-icon image {
  width: 28rpx;
  height: 28rpx;
}

.my-login-feature-title {
  display: block;
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.my-login-feature-subtitle {
  display: block;
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 15rpx;
  line-height: 1.2;
  text-align: center;
}

.my-login-guest-divider {
  width: 100%;
  margin-top: 26rpx;
  border-top: 2rpx dashed var(--line);
}

.my-login-explore {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-top: 20rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  line-height: 1.3;
}

.my-login-explore-action {
  color: var(--stamp);
  font-weight: 700;
}

.my-login-bottom-safe {
  height: 26rpx;
}

.my-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.my-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.my-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.my-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.my-brand-copy {
  display: flex;
  flex-direction: column;
}

.my-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.my-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.my-page-kicker {
  display: block;
  margin-bottom: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.my-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--ink);
  font-size: 53rpx;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.my-title-em {
  color: var(--stamp);
}

.profile-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 34rpx;
  padding: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
}

.profile-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}

.profile-avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border: 8rpx solid var(--surface);
  border-radius: 16rpx;
  background: #d1b79a;
  box-shadow: 0 0 0 2rpx var(--line);
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
}

.profile-avatar-fallback {
  opacity: 0.82;
}

.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin: 6rpx 16rpx 0 20rpx;
}

.profile-name {
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  line-height: 1.15;
}

.profile-role {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
  line-height: 1.4;
}

.profile-level-badge {
  flex-shrink: 0;
  padding: 10rpx 12rpx;
  border: 2rpx solid var(--stamp);
  color: var(--stamp);
  background: var(--surface);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.growth-module {
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.growth-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.growth-label {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.growth-label-title {
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
}

.growth-label-sub {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-value {
  flex-shrink: 0;
  color: var(--stamp);
  font-size: 28rpx;
  font-weight: 800;
}

.growth-value-total {
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 400;
}

.growth-track {
  position: relative;
  height: 16rpx;
  margin: 24rpx 12rpx 0 0;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: inset 0 0 0 2rpx rgba(51, 40, 36, 0.1);
}

.growth-track-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--stamp);
}

.growth-marker {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--stamp);
  border-radius: 50%;
  background: var(--surface);
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.growth-marker image {
  width: 23rpx;
  height: 23rpx;
}

.growth-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.growth-percent {
  color: var(--stamp);
  font-weight: 700;
}

.stat-grid {
  display: flex;
  flex-direction: row;
  margin: 24rpx 0 36rpx;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 6rpx;
  border-right: 2rpx solid var(--line);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-align: center;
}

.profile-home-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: -12rpx 0 30rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.28);
  background: rgba(255, 253, 248, 0.76);
  box-sizing: border-box;
}

.profile-home-entry:active {
  opacity: 0.78;
  transform: translateY(2rpx);
}

.profile-home-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: rgba(239, 210, 209, 0.72);
}

.profile-home-icon image {
  width: 32rpx;
  height: 32rpx;
}

.profile-home-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 14rpx;
}

.profile-home-kicker {
  color: var(--stamp);
  font-size: 14rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.profile-home-title {
  margin-top: 5rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.15;
}

.profile-home-subtitle {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 16rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-home-arrow {
  flex: none;
  margin-left: 12rpx;
  color: var(--stamp);
  font-size: 26rpx;
  font-weight: 700;
}

.sync-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin: 28rpx 0 36rpx;
  padding: 18rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-sizing: border-box;
}

.sync-card:active {
  opacity: 0.78;
  transform: translateY(2rpx);
}

.sync-card-busy {
  opacity: 0.7;
}

.sync-card-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: #efd2d1;
}

.sync-card-icon image {
  width: 34rpx;
  height: 34rpx;
}

.sync-card-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.sync-card-kicker {
  color: var(--stamp);
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

.sync-card-title {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-card-subtitle {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-card-action {
  display: flex;
  flex-shrink: 0;
  flex-direction: column;
  align-items: flex-end;
  color: var(--stamp);
  font-size: 16rpx;
  font-weight: 700;
  white-space: nowrap;
}

.sync-card-arrow {
  margin-top: 3rpx;
  font-size: 25rpx;
  line-height: 1;
}

.ai-source-note {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  border: 2rpx solid var(--line);
  background: rgba(241, 207, 132, 0.18);
  box-sizing: border-box;
}

.ai-source-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: rgba(201, 154, 73, 0.35);
}

.ai-source-icon image {
  width: 34rpx;
  height: 34rpx;
}

.ai-source-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.ai-source-title {
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ai-source-subtitle {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.35;
}

.ai-source-label {
  flex-shrink: 0;
  color: var(--stamp);
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: right;
}

.settings {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 36rpx;
}

.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--line);
  color: var(--ink);
  background: var(--paper);
  box-sizing: border-box;
}

.setting-row-link:active {
  opacity: 0.72;
  transform: translateY(2rpx);
}

.setting-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  background: var(--blush, #efd2d1);
}

.setting-icon image {
  width: 34rpx;
  height: 34rpx;
}

.setting-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.setting-title {
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}

.setting-subtitle {
  margin-top: 6rpx;
