<!-- 我的：城市猫咪观察手记 -->
<view class="my-page">
  <block wx:if="{{isLoggedIn}}">
  <scroll-view class="my-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="my-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="my-page-header" style="padding-right: {{headerRightInset}}px;">
        <view class="my-brand-mark">
          <view class="my-brand-symbol">
            <image src="/assets/tab-profile.svg" mode="aspectFit" />
          </view>
          <view class="my-brand-copy">
            <text class="my-brand-name">我的相遇</text>
            <text class="my-brand-sub">FIELD NOTES</text>
          </view>
        </view>
      </view>

      <text class="my-page-kicker">MY CAT JOURNAL</text>
      <view class="my-title">
        <text>留下每一次</text><text class="my-title-em">遇见</text>
      </view>

      <view class="profile-card">
        <view class="profile-top">
          <view class="profile-avatar-wrap">
            <image wx:if="{{profileAvatar}}" class="profile-avatar" src="{{profileAvatar}}" mode="aspectFill" />
            <image wx:else class="profile-avatar profile-avatar-fallback" src="/assets/cat-illustration.svg" mode="aspectFit" />
          </view>
          <view class="profile-copy">
            <text class="profile-name">{{profileName}}</text>
            <text class="profile-role">街角漫游者 · 记录生活里的猫</text>
          </view>
          <text class="profile-level-badge">LV.{{memberLevel}}</text>
        </view>

        <view class="growth-module">
          <view class="growth-head">
            <view class="growth-label">
              <text class="growth-label-title">猫爪成长经验</text>
              <text class="growth-label-sub">距离下一等级 {{nextMemberName}}</text>
            </view>
            <text class="growth-value">{{pawGrowth}} <text class="growth-value-total">/ {{nextGrowth}}</text></text>
          </view>
          <view class="growth-track">
            <view class="growth-track-fill" style="width: {{memberProgress}}%;"></view>
            <view
              class="growth-marker"
              style="left: {{memberProgress}}%; transform: translate(-{{memberProgress}}%, -50%);"
            >
              <image src="/assets/paw.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="growth-foot">
            <text>当前 LV.{{memberLevel}}</text>
            <text class="growth-percent">{{memberProgress}}% · 猫爪进度</text>
            <text wx:if="{{!memberIsMax}}">还差 {{growthToNext}} 猫爪</text>
            <text wx:else>继续城市冒险</text>
          </view>
        </view>
      </view>

      <view class="stat-grid">
        <view class="stat-item">
          <text class="stat-value">{{unlockedCount}}</text>
          <text class="stat-label">已发现</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{streakDays}}</text>
          <text class="stat-label">连续记录天数</text>
        </view>
      </view>

      <view class="profile-home-entry" bindtap="goProfile" aria-role="button" aria-label="我的主页">
        <view class="profile-home-icon">
          <image src="/assets/icon-poster-share-coral.svg" mode="aspectFit" />
        </view>
        <view class="profile-home-copy">
          <text class="profile-home-kicker">MY PROFILE</text>
          <text class="profile-home-title">我的主页</text>
          <text class="profile-home-subtitle">分享你的猫卡，认识同样爱猫的人</text>
        </view>
        <text class="profile-home-arrow">→</text>
      </view>

      <view
        wx:if="{{!isLoggedIn}}"
        class="sync-card {{syncBusy ? 'sync-card-busy' : ''}}"
        bindtap="onBindAccount"
        aria-role="button"
        aria-label="绑定当前微信账号并同步相遇记录"
      >
        <view class="sync-card-icon">
          <image src="/assets/doodle-spark.svg" mode="aspectFit" />
        </view>
        <view class="sync-card-copy">
          <text class="sync-card-kicker">{{syncKicker}}</text>
          <text class="sync-card-title">{{syncTitle}}</text>
          <text class="sync-card-subtitle">{{syncSubtitle}}</text>
        </view>
        <view class="sync-card-action">
          <text>{{syncActionText}}</text>
          <text class="sync-card-arrow">→</text>
        </view>
      </view>

      <view class="ai-source-note" aria-label="Ai创作声明">
        <view class="ai-source-icon">
          <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
        </view>
        <view class="ai-source-copy">
          <text class="ai-source-title">Ai创作声明</text>
          <text class="ai-source-subtitle">应用中所有图片与文案均有Ai参与二次创作</text>
        </view>
        <text class="ai-source-label">AI GENERATED</text>
      </view>

      <view class="settings">
        <view class="setting-row setting-row-link" bindtap="goPrivacy" aria-role="button" aria-label="打开隐私条款">
          <view class="setting-icon">
            <image src="/assets/paw.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">隐私条款</text>
            <text class="setting-subtitle">了解图片、档案与权限如何处理</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
        <view class="setting-row setting-row-link" bindtap="goAbout" aria-role="button" aria-label="打开关于猫咪咔咔">
          <view class="setting-icon">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">关于猫咪咔咔</text>
            <text class="setting-subtitle">认识我们的街角猫咪档案</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
        <view class="setting-row setting-row-link" bindtap="showFeedbackContact" aria-role="button" aria-label="功能建议及问题反馈">
          <view class="setting-icon">
            <image src="/assets/doodle-spark.svg" mode="aspectFit" />
          </view>
          <view class="setting-copy">
            <text class="setting-title">功能建议及问题反馈</text>
            <text class="setting-subtitle">欢迎告诉我们你的想法和使用问题</text>
          </view>
          <text class="setting-arrow">›</text>
        </view>
      </view>

      <view class="my-link" bindtap="goCamera" aria-role="button" aria-label="去遇见一只猫">
        <view class="my-link-copy">
          <text class="my-link-title">去遇见一只猫</text>
          <text class="my-link-sub">继续收集你的城市猫咪</text>
        </view>
        <image class="my-link-arrow" src="/assets/icon-arrow-right-coral.svg" mode="aspectFit" />
      </view>

      <view class="my-bottom-safe"></view>
    </view>
  </scroll-view>
  </block>

  <block wx:else>
  <scroll-view class="my-scroll my-login-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="my-login-content" style="padding-top: {{pageHeaderTop}}px;">
      <view class="my-login-page-header">
        <view class="my-login-brand-mark">
          <view class="my-login-brand-symbol">
            <image src="/assets/icon-user-coral.svg" mode="aspectFit" />
          </view>
          <view class="my-login-brand-copy">
            <text class="my-login-brand-name">我的相遇</text>
            <text class="my-login-brand-sub">FIELD NOTES</text>
          </view>
        </view>
      </view>

      <text class="my-login-kicker">YOUR FIELD NOTES</text>
      <view class="my-login-title">
        <text>留住每一次<text class="my-login-title-em">遇见</text></text>
      </view>

      <view class="my-login-guest-card">
        <view class="my-login-guest-head">
          <text>CAT ARCHIVE · GUEST</text>
          <text>未登录</text>
        </view>
        <view class="my-login-guest-body">
          <view class="my-login-guest-mark">
            <image src="/assets/maomi-kaka-logo-square-144.png" mode="aspectFit" />
          </view>
          <text class="my-login-guest-title">登录，开启你的<text class="my-login-title-em">猫档案</text></text>
          <text class="my-login-guest-subtitle">记录每一次遇见的猫，积累属于你的猫爪经验。</text>
          <button
            class="my-login-primary {{syncBusy ? 'my-login-primary-busy' : ''}}"
            disabled="{{syncBusy}}"
            open-type="chooseAvatar"
            bindchooseavatar="onChooseAvatar"
            hover-class="my-login-button-hover"
            aria-role="button"
            aria-label="微信授权登录"
          >
            <image src="/assets/icon-user-white.svg" mode="aspectFit" />
            <text>{{syncBusy ? '正在登录' : '微信授权登录'}}</text>
          </button>
        </view>
      </view>

      <view class="my-login-feature-grid">
        <view class="my-login-feature">
          <view class="my-login-feature-icon">
            <image src="/assets/icon-camera-coral.svg" mode="aspectFit" />
          </view>
          <text class="my-login-feature-title">收录相遇</text>
          <text class="my-login-feature-subtitle">保存档案</text>
        </view>
        <view class="my-login-feature">
          <view class="my-login-feature-icon">
            <image src="/assets/paw.svg" mode="aspectFit" />
          </view>
          <text class="my-login-feature-title">积累猫爪</text>
          <text class="my-login-feature-subtitle">成长升级</text>
        </view>
        <view class="my-login-feature">
          <view class="my-login-feature-icon">
            <image src="/assets/tab-album-active.svg" mode="aspectFit" />
          </view>
          <text class="my-login-feature-title">查看图鉴</text>
          <text class="my-login-feature-subtitle">随时可查</text>
        </view>
      </view>

      <view class="my-login-guest-divider"></view>
      <view class="my-login-explore" bindtap="goCamera" aria-role="button" aria-label="去相遇">
        <text>也可以先逛逛</text>
        <text class="my-login-explore-action">去相遇 →</text>
      </view>

      <view class="my-login-bottom-safe"></view>
    </view>
  </scroll-view>
  </block>

  <exception-modal
    visible="{{showException}}"
    eyebrow="{{exceptionEyebrow}}"
    title="{{exceptionTitle}}"
    message="{{exceptionMessage}}"
    primary-text="{{exceptionPrimaryText}}"
    bind:primary="onExceptionPrimary"
  />

  <view
    wx:if="{{showFeedbackContact}}"
    class="feedback-modal-layer"
    catchtap="stopFeedbackPropagation"
    aria-role="alertdialog"
    aria-label="功能建议及问题反馈"
  >
    <view class="feedback-modal-backdrop"></view>
    <view class="feedback-modal-card" catchtap="stopFeedbackPropagation">
      <view class="feedback-modal-symbol">
        <image src="/assets/doodle-spark.svg" mode="aspectFit" />
      </view>
      <text class="feedback-modal-eyebrow">FUNCTION NOTE · CONTACT</text>
      <text class="feedback-modal-title">功能建议及问题反馈</text>
      <text class="feedback-modal-message">欢迎添加微信：{{feedbackWechatId}} 告诉我们你的想法或遇到的问题</text>
      <text class="feedback-modal-detail">支持复制微信号，添加后即可反馈</text>
      <view class="feedback-modal-actions">
        <view class="feedback-modal-action feedback-modal-close" bindtap="closeFeedbackContact">
          <text>关闭</text>
        </view>
        <view class="feedback-modal-action feedback-modal-copy" bindtap="copyFeedbackContact">
          <text>复制</text>
        </view>
      </view>
    </view>
  </view>
</view>
