/* pages/my/my.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  background: var(--surface);
  color: var(--ink);
}

.my-page {
  min-height: 100vh;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.my-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.my-content {
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
}

.my-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.my-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.my-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.my-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.my-brand-copy {
  display: flex;
  flex-direction: column;
}

.my-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.my-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.my-level {
  padding: 10rpx 14rpx;
  border: 2rpx solid var(--line);
  color: var(--stamp);
  background: var(--paper);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.my-page-kicker {
  display: block;
  margin-bottom: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.my-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--ink);
  font-size: 53rpx;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.my-title-em {
  color: var(--stamp);
}

.profile-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 34rpx;
  padding: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--paper);
}

.profile-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  min-width: 0;
}

.profile-avatar-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 124rpx;
  height: 124rpx;
  overflow: hidden;
  border: 8rpx solid var(--surface);
  border-radius: 50%;
  background: #d1b79a;
  box-shadow: 0 0 0 2rpx var(--line);
}

.profile-avatar {
  width: 108rpx;
  height: 108rpx;
  opacity: 0.82;
}

.profile-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin: 6rpx 16rpx 0 20rpx;
}

.profile-name {
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  line-height: 1.15;
}

.profile-role {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
  line-height: 1.4;
}

.profile-level-badge {
  flex-shrink: 0;
  padding: 10rpx 12rpx;
  border: 2rpx solid var(--stamp);
  color: var(--stamp);
  background: var(--surface);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.growth-module {
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.growth-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
}

.growth-label {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.growth-label-title {
  color: var(--ink);
  font-size: 20rpx;
  font-weight: 700;
}

.growth-label-sub {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.growth-value {
  flex-shrink: 0;
  color: var(--stamp);
  font-size: 28rpx;
  font-weight: 800;
}

.growth-value-total {
  color: var(--muted-ink);
  font-size: 18rpx;
  font-weight: 400;
}

.growth-track {
  position: relative;
  height: 16rpx;
  margin: 24rpx 12rpx 0 0;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: inset 0 0 0 2rpx rgba(51, 40, 36, 0.1);
}

.growth-track-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--stamp);
}

.growth-marker {
  position: absolute;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid var(--stamp);
  border-radius: 50%;
  background: var(--surface);
  box-sizing: border-box;
  transform: translate(-50%, -50%);
}

.growth-marker image {
  width: 23rpx;
  height: 23rpx;
}

.growth-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 16rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.growth-percent {
  color: var(--stamp);
  font-weight: 700;
}

.stat-grid {
  display: flex;
  flex-direction: row;
  margin: 24rpx 0 36rpx;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.stat-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 6rpx;
  border-right: 2rpx solid var(--line);
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  color: var(--ink);
  font-size: 31rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-align: center;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--ink);
  font-size: 31rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.section-more {
  color: var(--stamp);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.record-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 14rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
}

.record-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 62rpx;
  height: 62rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #d7ae7e;
}

.record-dot image {
  width: 100%;
  height: 100%;
}

.record-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.record-name {
  overflow: hidden;
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-date {
  flex-shrink: 0;
  margin-left: 8rpx;
  color: var(--muted-ink);
  font-size: 16rpx;
}

.my-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  border-top: 2rpx solid var(--line);
  border-bottom: 2rpx solid var(--line);
}

.my-empty-mark {
  width: 78rpx;
  height: 78rpx;
  opacity: 0.3;
}

.my-empty-title {
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 700;
}

.my-empty-sub {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 21rpx;
}

.settings {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 36rpx;
}

.setting-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border: 2rpx solid var(--line);
  color: var(--ink);
  background: var(--paper);
  font-size: 21rpx;
}

.setting-arrow {
  color: var(--muted-ink);
  font-size: 31rpx;
  line-height: 1;
}

.dev-mode-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.24);
  background: var(--surface);
}

.dev-mode-entry:active,
.my-link:active {
  opacity: 0.78;
}

.dev-mode-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  background: #efd2d1;
}

.dev-mode-entry-icon image {
  width: 46rpx;
  height: 46rpx;
}

.dev-mode-entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.dev-mode-entry-kicker {
  color: var(--stamp);
  font-size: 16rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.dev-mode-entry-title {
  margin-top: 5rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.dev-mode-entry-subtitle {
  margin-top: 4rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
}

.dev-mode-entry-arrow,
.my-link-arrow {
  width: 30rpx;
  height: 30rpx;
  margin-left: 10rpx;
}

.my-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 20rpx;
  background: var(--paper-deep);
}

.my-link-copy {
  display: flex;
  flex-direction: column;
}

.my-link-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.my-link-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
}

.my-bottom-safe {
  height: 26rpx;
}
