/* pages/collection/collection.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  --paper-deep: #eee1d0;
  background: var(--surface);
  color: var(--ink);
}

.collection-page {
  min-height: 100vh;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.collection-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.collection-content {
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
}

.album-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.album-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.album-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.album-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.album-brand-copy {
  display: flex;
  flex-direction: column;
}

.album-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.album-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.album-level {
  padding: 10rpx 14rpx;
  border: 2rpx solid var(--line);
  color: var(--stamp);
  background: var(--paper);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.album-page-kicker {
  display: block;
  margin-bottom: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.album-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--ink);
  font-size: 56rpx;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.album-title-em {
  color: var(--stamp);
}

.album-count-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin: 38rpx 0 22rpx;
}

.album-count-value {
  color: var(--ink);
  font-size: 25rpx;
  font-family: var(--font-display);
  font-weight: 700;
}

.album-count-code {
  color: var(--stamp);
  font-size: 17rpx;
  letter-spacing: 1rpx;
}

.filter-scroll {
  width: 100%;
  margin-bottom: 10rpx;
}

.filter-list {
  display: flex;
  flex-direction: row;
  padding: 2rpx 0 8rpx;
}

.filter-chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-right: 12rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid var(--line);
  color: var(--muted-ink);
  background: var(--surface);
  font-size: 20rpx;
}

.filter-chip-active {
  border-color: var(--stamp);
  color: var(--surface);
  background: var(--stamp);
}

.filter-count {
  margin-left: 7rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
}

.filter-chip-active .filter-count {
  color: rgba(255, 253, 248, 0.82);
}

.album-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx 12rpx;
  padding-top: 14rpx;
}

.album-entry {
  overflow: hidden;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-shadow: 0 10rpx 0 rgba(51, 40, 36, 0.07);
}

.album-entry:nth-child(2n) {
  margin-top: 0;
}

.cat-portrait {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 266rpx;
  overflow: hidden;
  /* 主体图使用透明画布时，让猫咪外部保持纯白，避免米色块抢视觉。 */
  background: #fff;
}

.cat-photo {
  display: block;
  width: 100%;
  height: 100%;
}

.cat-photo-fallback {
  width: 132rpx;
  height: 132rpx;
  opacity: 0.32;
}

.level-mark {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding: 7rpx 10rpx;
  border: 2rpx solid rgba(255, 253, 248, 0.9);
  background: rgba(255, 253, 248, 0.9);
  font-weight: 700;
}

.level-mark-code {
  margin-right: 6rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.level-mark text:last-child {
  font-size: 17rpx;
}

.level-mark-C { color: #6f6b62; }
.level-mark-U { color: #9c6d35; }
.level-mark-R { color: #3f7189; }
.level-mark-SR { color: #74558b; }
.level-mark-UR { color: #873e30; }

.new-mark {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  padding: 5rpx 8rpx;
  color: var(--surface);
  background: var(--stamp);
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.cat-label {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 16rpx 18rpx;
  border-top: 2rpx solid var(--line);
  background: var(--surface);
}

.cat-label-name {
  overflow: hidden;
  max-width: 100%;
  color: var(--ink);
  font-size: 27rpx;
  font-family: var(--font-display);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-label-meta {
  display: block;
  overflow: hidden;
  max-width: 100%;
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-album {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 112rpx 0 110rpx;
}

.empty-album-mark {
  width: 84rpx;
  height: 84rpx;
  opacity: 0.3;
}

.empty-album-title {
  margin-top: 18rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-album-sub {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 22rpx;
}

.album-footnote {
  padding: 30rpx 8rpx;
  color: var(--muted-ink);
  font-size: 19rpx;
  text-align: center;
}

.collection-bottom-safe {
  height: 26rpx;
}
