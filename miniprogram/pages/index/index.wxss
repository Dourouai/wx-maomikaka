/* pages/index/index.wxss */
page {
  --ink: #332824;
  --muted-ink: #8c7569;
  --line: #d7c5b3;
  --stamp: #9b442a;
  --coral: #e67e5f;
  --paper: #f8f1e7;
  --surface: #fffdf8;
  --paper-deep: #eee1d0;
  background: var(--surface);
  color: var(--ink);
}

.home-page {
  min-height: 100vh;
  background-color: var(--surface);
  background-image: radial-gradient(rgba(155, 68, 42, 0.13) 1.4rpx, transparent 1.4rpx);
  background-size: 32rpx 32rpx;
}

.home-scroll {
  height: calc(100vh - 130rpx - env(safe-area-inset-bottom));
}

.home-content {
  padding: 36rpx 36rpx 0;
  box-sizing: border-box;
}

.home-page-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
  box-sizing: border-box;
}

.home-brand-mark {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.home-brand-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
}

.home-brand-symbol image {
  width: 34rpx;
  height: 34rpx;
}

.home-brand-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home-brand-name {
  color: var(--ink);
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.1;
}

.home-brand-sub {
  margin-top: 5rpx;
  color: var(--muted-ink);
  font-size: 13rpx;
  letter-spacing: 3rpx;
  line-height: 1;
}

.home-kicker {
  display: block;
  margin-bottom: 16rpx;
  color: var(--stamp);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.home-title {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  color: var(--ink);
  font-size: 60rpx;
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.home-title-em {
  color: var(--stamp);
}

.home-subtitle {
  display: block;
  margin-top: 14rpx;
  color: var(--muted-ink);
  font-size: 23rpx;
  line-height: 1.5;
}

.home-subtitle-line {
  margin-top: 2rpx;
}

.home-can-strip {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin: 44rpx 0 30rpx;
}

.home-can-copy {
  display: flex;
  flex-direction: column;
}

.home-can-label {
  color: var(--muted-ink);
  font-size: 20rpx;
}

.home-cans {
  display: flex;
  flex-direction: row;
  /* 罐头盖会向上突出 10rpx，留足视觉间距，避免贴住说明文字。 */
  margin-top: 26rpx;
}

.home-can {
  position: relative;
  display: block;
  width: 66rpx;
  height: 54rpx;
  margin-right: 10rpx;
  border: 2rpx solid var(--stamp);
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  background: var(--coral);
}

.home-can::before {
  position: absolute;
  top: -10rpx;
  left: 6rpx;
  width: 54rpx;
  height: 16rpx;
  border: 2rpx solid var(--stamp);
  border-radius: 50%;
  background: var(--surface);
  content: '';
}

.home-can::after {
  position: absolute;
  top: 18rpx;
  left: 24rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--stamp);
  content: '';
}

.home-can-used {
  border-color: var(--line);
  background: transparent;
}

.home-can-used::before {
  border-color: var(--line);
  background: var(--surface);
}

.home-can-used::after {
  top: 23rpx;
  left: 19rpx;
  width: 18rpx;
  height: 3rpx;
  border-radius: 0;
  background: var(--line);
}

.home-can-count {
  color: var(--stamp);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.home-lens {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 578rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--paper-deep);
}

.home-lens::before {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  left: 28rpx;
  border: 2rpx dashed rgba(51, 40, 36, 0.33);
  border-radius: 20rpx;
  content: '';
}

.home-lens::after {
  position: absolute;
  right: 48rpx;
  bottom: 48rpx;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid rgba(74, 101, 73, 0.55);
  border-radius: 50%;
  content: '';
}

.home-lens-camera {
  position: relative;
  z-index: 1;
  display: block;
  width: 428rpx;
  height: 286rpx;
  filter: drop-shadow(0 16rpx 16rpx rgba(51, 40, 36, 0.18));
}

.home-lens-label {
  position: absolute;
  right: 0;
  bottom: 58rpx;
  left: 0;
  z-index: 2;
  color: rgba(51, 40, 36, 0.62);
  font-size: 20rpx;
  text-align: center;
}

.primary-action {
  display: flex;
  flex: none;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: none;
  height: 102rpx;
  margin-top: 28rpx;
  margin-right: 0;
  margin-left: 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  background: var(--stamp);
  box-shadow: 0 14rpx 0 rgba(75, 29, 18, 0.12);
  line-height: normal;
}

.primary-action::after {
  border: 0;
}

.primary-action:active {
  transform: translateY(4rpx);
  box-shadow: 0 9rpx 0 rgba(75, 29, 18, 0.12);
}

.primary-action-camera {
  width: 32rpx;
  height: 32rpx;
  margin-right: 14rpx;
}

.primary-action-title {
  color: var(--surface);
  font-size: 28rpx;
  font-weight: 750;
}

.home-note {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
  color: var(--muted-ink);
  font-size: 20rpx;
  text-align: center;
}

.home-upload-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.36);
  border-radius: 18rpx;
  background: rgba(255, 253, 248, 0.78);
}

.home-upload-entry:active {
  background: #fff0e8;
  transform: translateY(2rpx);
}

.home-upload-entry-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: var(--coral);
}

.home-upload-entry-icon image {
  width: 30rpx;
  height: 30rpx;
}

.home-upload-entry-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 16rpx;
}

.home-upload-entry-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.2;
}

.home-upload-entry-subtitle {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted-ink);
  font-size: 18rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-upload-entry-arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
}

.home-bottom-safe {
  height: 26rpx;
}
