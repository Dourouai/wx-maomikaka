/* 微信头像昵称填写能力：只在用户主动点击资料卡设置时出现。 */
.profile-auth-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10000;
}

.profile-auth-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(51, 40, 36, 0.6);
}

.profile-auth-card {
  position: absolute;
  right: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 28rpx;
  padding: 28rpx 24rpx 24rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-shadow: 0 26rpx 56rpx rgba(51, 40, 36, 0.26);
  box-sizing: border-box;
}

.profile-auth-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed var(--line);
}

.profile-auth-head > view:first-child {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.profile-auth-eyebrow {
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.profile-auth-title {
  margin-top: 12rpx;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.1;
}

.profile-auth-subtitle {
  margin-top: 8rpx;
  color: var(--muted-ink);
  font-size: 17rpx;
  line-height: 1.4;
}

.profile-auth-close {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--line);
  border-radius: 50%;
  background: var(--paper);
}

.profile-auth-close image {
  width: 22rpx;
  height: 22rpx;
}

.profile-auth-form {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
  padding: 22rpx 0 16rpx;
}

.profile-auth-avatar-field {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.profile-auth-avatar-button {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx !important;
  min-width: 108rpx;
  max-width: 108rpx;
  height: 108rpx;
  min-height: 108rpx;
  max-height: 108rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--paper);
  box-shadow: 0 4rpx 0 rgba(84, 69, 54, 0.06);
  box-sizing: border-box;
}

.profile-auth-avatar-button::after {
  border: 0;
}

.profile-auth-avatar-button image {
  display: block;
  width: 94rpx;
  height: 94rpx;
  border: 4rpx solid var(--surface);
  border-radius: 14rpx;
  box-sizing: border-box;
}

.profile-auth-avatar-fallback {
  padding: 8rpx;
  background: #d1b79a;
}

.profile-auth-field-label {
  display: block;
  margin-top: 6rpx;
  color: var(--muted-ink);
  font-size: 15rpx;
  line-height: 1.3;
  text-align: center;
}

.profile-auth-nickname-field {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 76rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
  box-sizing: border-box;
}

.profile-auth-nickname-field > .profile-auth-field-label {
  flex: none;
  width: 96rpx;
  margin-top: 0;
  color: var(--ink);
  font-size: 19rpx;
  font-weight: 700;
  text-align: left;
}

.profile-auth-nickname-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin-top: 0;
  padding: 0 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  color: var(--ink);
  background: var(--paper);
  font-size: 19rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.profile-auth-nickname-input::placeholder {
  color: #b8a79a;
  font-size: 16rpx;
}

.profile-auth-note {
  display: block;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
  color: var(--muted-ink);
  font-size: 15rpx;
  line-height: 1.45;
}

.profile-auth-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 22rpx;
}

.profile-auth-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.profile-auth-cancel {
  width: 156rpx;
  border: 2rpx solid var(--line);
  color: var(--muted-ink);
  background: var(--paper);
}

.profile-auth-confirm {
  flex: 1;
  border: 2rpx solid var(--stamp);
  color: var(--surface);
  background: var(--stamp);
  box-shadow: 0 8rpx 0 rgba(155, 68, 42, 0.16);
}

.profile-auth-confirm-busy {
  opacity: 0.58;
}

.profile-auth-action:active {
  opacity: 0.76;
  transform: translateY(2rpx);
}

/* 功能反馈与档案操作统一使用二次确认弹窗的视觉语言。 */
.feedback-modal-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10001;
}

.feedback-modal-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(51, 40, 36, 0.6);
}

.feedback-modal-card {
  position: absolute;
  top: 50%;
  right: 36rpx;
  left: 36rpx;
  padding: 38rpx 28rpx 32rpx;
  border: 2rpx solid var(--line);
  background: var(--surface);
  box-shadow: 0 26rpx 56rpx rgba(51, 40, 36, 0.26);
  text-align: center;
  transform: translateY(-50%);
  box-sizing: border-box;
}

.feedback-modal-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto 20rpx;
  border: 2rpx solid rgba(155, 68, 42, 0.35);
  border-radius: 50%;
  background: #efd2d1;
}

.feedback-modal-symbol image {
  width: 38rpx;
  height: 38rpx;
}

.feedback-modal-eyebrow {
  display: block;
  color: var(--stamp);
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 16rpx;
  line-height: 1;
  letter-spacing: 2.56rpx;
}

.feedback-modal-title {
  display: block;
  margin: 18rpx 0 0;
  color: var(--ink);
  font-family: var(--font-display);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
}

.feedback-modal-message {
  display: block;
  margin: 14rpx 0 0;
  color: var(--muted-ink);
  font-family: var(--font-display);
  font-size: 20rpx;
